<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 440" width="880" height="440">
  <defs>
    <linearGradient id="bg-blog-2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e1b4b" />
      <stop offset="100%" stop-color="#4338ca" />
    </linearGradient>
    <radialGradient id="glow-blog-2" cx="80%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#6366f1" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
    </radialGradient>
    <pattern id="grid-blog-2" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="880" height="440" fill="url(#bg-blog-2)" />
  <rect width="880" height="440" fill="url(#grid-blog-2)" />
  <rect width="880" height="440" fill="url(#glow-blog-2)" />

  <!-- Accent glow orb -->
  <circle cx="700" cy="220" r="180" fill="#6366f1" opacity="0.12" filter="blur(40px)" />

  <!-- Geometric Illustration -->
  <circle cx="680" cy="220" r="140" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="8 8" opacity="0.4"/>
           <polygon points="680,120 780,220 680,320 580,220" fill="none" stroke="#818cf8" stroke-width="2" opacity="0.5"/>
           <rect x="630" y="170" width="100" height="100" rx="20" fill="#1e1b4b" stroke="#818cf8" stroke-width="2"/>
           <path d="M660 220l15 15 30-30" stroke="#a5b4fc" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- Content Group -->
  <g transform="translate(60, 80)">
    <!-- Category Badge -->
    <rect x="0" y="0" width="123.5" height="32" rx="16" fill="rgba(99, 102, 241, 0.15)" stroke="#6366f1" stroke-width="1"/>
    <text x="15" y="21" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" fill="#6366f1" letter-spacing="1">ERP SYSTEMS</text>

    <!-- Title -->
    <text x="0" y="75" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="800" fill="#ffffff" letter-spacing="-0.5">
      <tspan x="0" dy="0">Next-Gen Payroll Engine 2027</tspan>
    </text>

    <!-- Subtitle -->
    <text x="0" y="115" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="400" fill="#94a3b8">
      <tspan x="0" dy="0">Sub-second pay run execution, real-time tax valida</tspan>
      <tspan x="0" dy="22">tion &amp; cloud ledger settlement</tspan>
    </text>

    <!-- Platform Brand Stamp -->
    <g transform="translate(0, 195)">
      <circle cx="10" cy="10" r="10" fill="#3b82f6"/>
      <path d="M6 10l3 3 5-6" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="28" y="14" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#cbd5e1">Master HRMS Editorial</text>
    </g>
  </g>
</svg>