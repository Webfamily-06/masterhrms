<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <appSettings>
    <add key="64BitRegistrationBatFile" value="dlls\64bit.bat"/>
    <add key="32BitRegistrationBatFile" value="dlls\32bit.bat"/>
    <add key="MasterHrmsApiBaseUrl" value="https://api.masterhrms.com"/>
    <add key="DefaultAdmsPushUrl" value="api.masterhrms.com"/>
    <add key="DefaultAdmsPushPort" value="80"/>
  </appSettings>
</configuration>
