# MASTERHRMS — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS TO REPOSITORY. USE IN SECURE SECRET STORE OR CI/CD SECRETS.

# Server & Node Configuration
NODE_ENV=staging
PORT=4000
HOST=0.0.0.0
BASE_DOMAIN=staging.masterhrms.com
FRONTEND_URL=https://staging.masterhrms.com
CORS_ORIGIN=https://staging.masterhrms.com,https://*.staging.masterhrms.com

# PostgreSQL Staging Connection (Includes Connection Pooling Parameters)
# Recommended: connection_limit=25 to prevent pool starvation under concurrent loads
# pool_timeout=10 bounds waiting queue latency to 10 seconds
DATABASE_URL=postgresql://staging_user:CHANGE_ME_PASSWORD@staging-db.internal:5432/masterhrms_staging?schema=public&connection_limit=25&pool_timeout=10

# Authentication & Cryptography Secrets (Generate via `openssl rand -hex 32`)
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_STAGING_KEY
JWT_EXPIRY=7d
COOKIE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_COOKIE_KEY
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Razorpay Platform Billing (Domain A) — MANDATORY SANDBOX MODE
# In Phase A9 Staging, only test credentials (rzp_test_*) are permitted.
RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER_KEY_ID
RAZORPAY_KEY_SECRET=PLACEHOLDER_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_TEST_WEBHOOK_SECRET

# Logging & Observability
LOG_LEVEL=info
LOG_FORMAT=json
REDACT_KEYS=authorization,password,password_hash,keySecret,token,two_factor_secret,cookie

# Storage & Backups
BACKUP_DIR=/var/backups/masterhrms
UPLOAD_DIR=/var/data/masterhrms/uploads
MAX_FILE_SIZE_MB=25

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
