# MASTERHRMS — Phase C3.5-A Staging Environment Variables Template
# Copy this file to .env.staging-sfu and configure values for your environment.
# DO NOT commit real secrets or production credentials to source control.

# ==============================================================================
# 1. LIVEKIT SFU CONFIGURATION
# ==============================================================================
# The IP address advertised by LiveKit to WebRTC peers for media candidate exchange.
# For local development: 127.0.0.1
# For staging WAN testing: The public IPv4 or staging host address
NODE_IP=127.0.0.1

# LiveKit API Key used for JWT issuer (iss) and server identification
LIVEKIT_API_KEY=staging_livekit_key_masterhrms_2026

# LiveKit API Secret used exclusively for signing room access JWTs (min 32 chars)
# MUST NOT be shared with Coturn or any other service.
LIVEKIT_API_SECRET=staging_livekit_secret_masterhrms_at_least_32_characters_random

# The URL exposed to clients for LiveKit WebSocket signaling
# For local development: ws://127.0.0.1:7880
# For staging TLS: wss://sfu-staging.masterhrms.com
LIVEKIT_URL=ws://127.0.0.1:7880

# ==============================================================================
# 2. COTURN STUN/TURN RELAY CONFIGURATION (RFC 7635)
# ==============================================================================
# Shared secret for generating ephemeral HMAC-SHA1 Coturn REST API credentials.
# Coturn turnserver verifies client username (<expiry>:<userId>) and password (HMAC).
# MUST NOT be shared with LiveKit API secret or exposed to the frontend in plain text.
TURN_SHARED_SECRET=staging_turn_hmac_secret_masterhrms_at_least_32_characters_random

# Authentication realm for Coturn long-term credential mechanism
TURN_REALM=sfu-staging.masterhrms.com

# Public hostname or IP returned to WebRTC clients in ICE server configurations
# For local development: 127.0.0.1
# For staging WAN: sfu-staging.masterhrms.com (or staging public IP)
TURN_PUBLIC_HOST=sfu-staging.masterhrms.com

# Standard plain STUN/TURN listener port (UDP/TCP)
TURN_UDP_PORT=3478

# Secure TURNS listener port (TLS over TCP)
TURN_TLS_PORT=5349

