{
  "name": "masterhrms-device-hub",
  "version": "2.5.0",
  "description": "MasterHRMS Biometric Device Manager — Modern macOS Glassmorphism Desktop Client for ZKTeco and eSSL Terminals",
  "main": "main.js",
  "author": "MasterHRMS Engineering <support@masterhrms.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:connection": "node src/test-cli.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.masterhrms.devicehub",
    "productName": "MasterHRMS Device Manager",
    "copyright": "Copyright © 2026 MasterHRMS. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/favicon.ico",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "assets/favicon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/favicon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
