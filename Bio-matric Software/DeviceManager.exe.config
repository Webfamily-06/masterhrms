<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
    </startup>
  <appSettings>
    <add key="64BitRegistrationBatFile" value="dlls\64bit.bat"/>
    <add key="32BitRegistrationBatFile" value="dlls\32bit.bat"/>
    <add key="TestAPIResourceURL" value="https://masterhrms.com/api/biometric"/>
    <add key="ADMSPushServerURL" value="https://masterhrms.com/iclock"/>
    <add key="ADMSPushPort" value="443"/>
    <add key="ADMSPushProtocol" value="HTTPS"/>
    <add key="ApplicationTitle" value="MasterHRMS Device Manager"/>
    <add key="Publisher" value="MasterHRMS"/>
    <add key="SupportURL" value="https://masterhrms.com"/>
  </appSettings>
</configuration>
