# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Backend API URL (Express + Supabase Postgres)
VITE_API_URL="http://localhost:4000/api"

# Server-Side SMTP Mail Server Configuration (Strictly Server-Only, Never Prefix With VITE_)
SMTP_HOST="mail.masterhrms.com"
SMTP_PORT="465"
SMTP_USER="support@masterhrms.com"
SMTP_PASS="your_smtp_password"
SMTP_ENCRYPTION="ssl"
SMTP_FROM_NAME="Master HRMS System"
SMTP_FROM_EMAIL="support@masterhrms.com"

# Pusher WebSockets Realtime Configuration
VITE_PUSHER_APP_ID="your_pusher_app_id"
VITE_PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
VITE_PUSHER_CLUSTER="ap2"
VITE_PUSHER_ENABLED="true"

# Cloudflare Turnstile Bot Protection
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_HOSTNAMES="localhost,127.0.0.1,app.masterhrms.com,masterhrms.com"
TURNSTILE_ENFORCEMENT_MODE="off" # Options: off | audit | enforce

# Cloudflare R2 / S3 Storage Configuration
STORAGE_PROVIDER="local" # Options: local | r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_ENDPOINT=""

# Cloudflare Access (Zero Trust for Super Admin)
CLOUDFLARE_ACCESS_TEAM_NAME=""
CLOUDFLARE_ACCESS_AUD=""
CLOUDFLARE_ACCESS_ENFORCE="false"

