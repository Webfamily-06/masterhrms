# MySQL Backend API URL
VITE_API_URL="http://localhost:4000/api"

# SMTP Mail Server Configuration Template
VITE_SMTP_HOST="smtp.example.com"
VITE_SMTP_PORT="465"
VITE_SMTP_USER="support@example.com"
VITE_SMTP_PASS="your-smtp-password"
VITE_SMTP_ENCRYPTION="ssl"
