{
  "name": "MasterHRMS",
  "displayName": "MasterHRMS",
  "expo": {
    "name": "MasterHRMS",
    "slug": "masterhrms",
    "version": "0.0.1",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masterhrms.app",
      "googleServicesFile": "./ios/MasterHRMS/GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "NSCameraUsageDescription": "MasterHRMS requires access to your camera for profile photo and attachment uploads.",
        "NSMicrophoneUsageDescription": "MasterHRMS requires access to your microphone for recording voice notes.",
        "NSPhotoLibraryUsageDescription": "MasterHRMS requires access to your photo library to select and upload photos.",
        "NSFaceIDUsageDescription": "MasterHRMS uses Face ID to securely unlock your workspace."
      }
    },
    "android": {
      "package": "com.masterhrms.app",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MasterHRMS to use Face ID to securely unlock your workspace."
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
