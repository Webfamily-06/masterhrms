# MasterHRMS Mobile Application Environment Configuration
# Copy this file to .env to configure your local mobile development environment.

# Active Environment ('development' | 'staging' | 'production')
EXPO_PUBLIC_APP_ENV=development

# Explicit API Base URL (defaults to your local machine LAN IP:4000)
# For physical devices on local Wi-Fi, set to your computer's LAN IPv4.
# For Android emulator: http://10.0.2.2:4000
# For iOS simulator: http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.176:4000

# Optional: Configure just the LAN IPv4 of your development machine
EXPO_PUBLIC_DEV_LAN_IP=192.168.1.176

# Staging API Base URL (required when EXPO_PUBLIC_APP_ENV=staging)
# EXPO_PUBLIC_STAGING_API_BASE_URL=https://staging.masterhrms.com
