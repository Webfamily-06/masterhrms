PORT=4000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Transaction pooler)
# Format: postgresql://USER:PASSWORD@HOST:6543/DATABASE_NAME?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Direct Connection (Session mode for migrations & DDL)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT Secret
JWT_SECRET="master-hrms-jwt-super-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:8080"

# SMTP Mail Server Configuration Template
SMTP_HOST="mail.masterhrms.com"
SMTP_PORT="465"
SMTP_USER="support@masterhrms.com"
SMTP_PASS="your_smtp_password"
SMTP_ENCRYPTION="ssl"
SMTP_FROM_NAME="Master HRMS System"
SMTP_FROM_EMAIL="support@masterhrms.com"

# Storage Encryption (Optional: 64-char hex key. Defaults to scrypt derived from JWT_SECRET)
# STORAGE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Matrix COSEC Biometric API Integration (Optional)
# MATRIX_COSEC_BASE_URL="http://192.168.1.100:8080"
# MATRIX_COSEC_API_KEY="your_matrix_cosec_api_key"
