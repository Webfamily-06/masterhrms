model CrmDeal {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  name        String    @db.VarChar(200)
  customer    String    @db.VarChar(150)
  stage       String    @default("Proposal") @db.VarChar(50) // In Discussion | Proposal | Contract Signed | Won | Lost
  value       Decimal   @default(0.00) @db.Decimal(15, 2)
