  reference     String?       @db.VarChar(150) // Invoice #, Expense #, Salary #, POS #
  referenceType String?       @map("reference_type") @db.VarChar(50) // invoice, expense, payroll, pos, manual
  description   String        @db.Text
  totalAmount   Decimal       @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  status        String        @default("posted") @db.VarChar(30) // draft, posted, void
  createdById   String?       @map("created_by_id") @db.VarChar(36)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  JournalItem[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

model JournalItem {
  id             String   @id @default(uuid()) @db.VarChar(36)
  journalEntryId String   @map("journal_entry_id") @db.VarChar(36)
  accountId      String   @map("account_id") @db.VarChar(36)
  type           String   @db.VarChar(10) // debit, credit
  debit          Decimal  @default(0.00) @db.Decimal(15, 2)
  credit         Decimal  @default(0.00) @db.Decimal(15, 2)
