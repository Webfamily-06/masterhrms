  deliveryKey String   @unique @map("delivery_key") @db.VarChar(64)
  eventType   String   @map("event_type") @db.VarChar(100)
  signatureOk Boolean  @default(false) @map("signature_ok")
  payload     Json
  receivedAt  DateTime @default(now()) @map("received_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, provider, receivedAt])
  @@map("payment_webhook_events")
}

model HeldOrder {
  id           String   @id @default(uuid()) @db.VarChar(36)
  tenantId     String   @map("tenant_id") @db.VarChar(36)
  label        String?  @db.VarChar(100)
  customerName String?  @map("customer_name") @db.VarChar(255)
  cartData     Json     @map("cart_data")
