  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  cycleId       String   @map("cycle_id") @db.VarChar(36)
  parentId      String?  @map("parent_id") @db.VarChar(36)
  category      String?  @default("Strategy") @db.VarChar(100)
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  ownerId       String   @map("owner_id") @db.VarChar(36)
  departmentId  String?  @map("department_id") @db.VarChar(36)
