datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AppRole {
  super_admin
  hr_admin
  manager
  employee
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern
}

enum EmployeeStatus {
  active
  on_leave
  terminated
}

enum AttendanceStatus {
  present
  absent
  half_day
  late
  on_leave
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum PayrollStatus {
  draft
  processing
  completed
  paid
}

model User {
  id                    String     @id @default(uuid()) @db.VarChar(36)
  email                 String     @unique @db.VarChar(255)
  passwordHash          String     @map("password_hash") @db.VarChar(255)
  twoFactorEnabled      Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret       String?    @map("two_factor_secret") @db.VarChar(255)
  twoFactorBackupCodes  String?    @map("two_factor_backup_codes") @db.Text
  twoFactorConfirmedAt  DateTime?  @map("two_factor_confirmed_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  profile      Profile?
  roles        UserRole[]
  employees    Employee[]
  workspaceRoleAssignments UserRoleAssignment[]
  twoFactorOtps            TwoFactorOtp[]

  @@map("users")
}

model Tenant {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  profiles      Profile[]
  userRoles     UserRole[]
  workspaceRoles         WorkspaceRole[]
  userRoleAssignments    UserRoleAssignment[]
  tenantModules          TenantModule[]
  departments   Department[]
  employees     Employee[]
  attendance    Attendance[]
  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  payrollRuns   PayrollRun[]
  payslips      Payslip[]
  tenantAddons  TenantAddon[]
  subscription  TenantSubscription?
  subscriptionPolicyAudits SubscriptionPolicyAudit[]
  gatewayTransactions PaymentGatewayTransaction[]
  paymentWebhookEvents PaymentWebhookEvent[]
  okrCycles            OkrCycle[]
  okrObjectives        OkrObjective[]
  assets               Asset[]
  assetCategories      AssetCategory[]
  assetRequests        AssetRequest[]
  assetDisposalBatches AssetDisposalBatch[]
  assetActivityLogs    AssetActivityLog[]
  jobPostings          JobPosting[]
  jobCandidates        JobCandidate[]
  shiftDefinitions     ShiftDefinition[]
  shiftRosters         ShiftRoster[]
  shiftSwapRequests    ShiftSwapRequest[]
  expenseCategories    ExpenseCategory[]
  expenseClaims        ExpenseClaim[]
  trainingCourses      TrainingCourse[]
  courseEnrollments    CourseEnrollment[]
  employeeExits        EmployeeExit[]
  companyDocuments     CompanyDocument[]
  helpdeskTickets        HelpdeskTicket[]
  platformSupportTickets PlatformSupportTicket[]
  announcements          Announcement[]
  customForms            CustomForm[]
  formSubmissions        FormSubmission[]
  biometricDevices       BiometricDevice[]
  biometricPunchLogs     BiometricPunchLog[]
  chartOfAccounts        ChartOfAccount[]
  journalEntries         JournalEntry[]
  contracts              Contract[]
  budgetPlans            BudgetPlan[]
  financialGoals         FinancialGoal[]
  productCategories      ProductCategory[]
  brands                 Brand[]
  units                  Unit[]
  taxRates               TaxRate[]
  warehouses             Warehouse[]
  products               Product[]
  customers              Customer[]
  suppliers              Supplier[]
  sales                  Sale[]
  heldOrders             HeldOrder[]
  purchases              Purchase[]
  stockTransfers         StockTransfer[]
  stockAdjustments       StockAdjustment[]
  chatMessages           ChatMessage[]
  crmLeads               CrmLead[]
  crmProposals           CrmProposal[]
  projects               Project[]
  projectTasks           ProjectTask[]
  cashRegisters          CashRegister[]
  registerShifts         RegisterShift[]
  @@map("tenants")
}

model Profile {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @unique @map("user_id") @db.VarChar(36)
  email     String?  @db.VarChar(255)
  fullName  String?  @map("full_name") @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  tenantId  String?  @map("tenant_id") @db.VarChar(36)
  phone     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  role      AppRole  @default(employee)
  tenantId  String?  @map("tenant_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@unique([userId, role, tenantId])
  @@map("user_roles")
}

model Department {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees     Employee[]
  jobPostings   JobPosting[]
  announcements Announcement[]
  customForms   CustomForm[]
  budgetPlans   BudgetPlan[]

  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid()) @db.VarChar(36)
  tenantId       String         @map("tenant_id") @db.VarChar(36)
  userId         String?        @map("user_id") @db.VarChar(36)
  departmentId   String?        @map("department_id") @db.VarChar(36)
  managerId      String?        @map("manager_id") @db.VarChar(36)
  employeeCode   String         @map("employee_code") @db.VarChar(50)
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String         @db.VarChar(255)
  phone          String?        @db.VarChar(50)
  position       String?        @db.VarChar(150)
  employmentType EmploymentType @default(full_time) @map("employment_type")
  status         EmployeeStatus @default(active)
  salary         Decimal?       @db.Decimal(12, 2)
  joinedAt       DateTime?      @map("joined_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant                      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  department                  Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager                     Employee?                     @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates                Employee[]                    @relation("ManagerSubordinates")
  attendance                  Attendance[]
  leaveRequests               LeaveRequest[]
  payslips                    Payslip[]
  okrObjectives               OkrObjective[]
  okrCheckins                 OkrCheckin[]
  okrReviewsReceived          OkrReview[]                   @relation("OkrReviewsReceived")
  okrReviewsGiven             OkrReview[]                   @relation("OkrReviewsGiven")
  assignedAssets              Asset[]
  assetAssignments            AssetAssignment[]
  assetRequests               AssetRequest[]
  conductedInterviews         JobCandidateInterview[]
  shiftRosters                ShiftRoster[]
  shiftSwapsRequested         ShiftSwapRequest[]            @relation("ShiftSwapsRequested")
  shiftSwapsTargeted          ShiftSwapRequest[]            @relation("ShiftSwapsTargeted")
  expenseClaims               ExpenseClaim[]
  courseEnrollments           CourseEnrollment[]
  employeeExits               EmployeeExit[]
  companyDocuments            CompanyDocument[]
  helpdeskTickets             HelpdeskTicket[]
  announcements               Announcement[]                @relation("AnnouncementAuthor")
  announcementAcknowledgements AnnouncementAcknowledgement[]
  authoredForms               CustomForm[]                  @relation("FormAuthor")
  formSubmissions             FormSubmission[]
  biometricPunchLogs          BiometricPunchLog[]

  @@index([tenantId, status])  // Perf: list active employees by tenant
  @@index([tenantId, departmentId]) // Perf: filter by department
  @@map("employees")
}

model Attendance {
  id         String           @id @default(uuid()) @db.VarChar(36)
  tenantId   String           @map("tenant_id") @db.VarChar(36)
  employeeId String           @map("employee_id") @db.VarChar(36)
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  hours      Decimal?         @db.Decimal(5, 2)
  status     AttendanceStatus @default(present)
  notes      String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])    // Perf: daily attendance summary
  @@index([tenantId, status])  // Perf: filter present/absent/late
  @@map("attendance")
}

model LeaveType {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  daysPerYear Int      @default(0) @map("days_per_year")
  color       String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id          String      @id @default(uuid()) @db.VarChar(36)
  tenantId    String      @map("tenant_id") @db.VarChar(36)
  employeeId  String      @map("employee_id") @db.VarChar(36)
  leaveTypeId String?     @map("leave_type_id") @db.VarChar(36)
  approverId  String?     @map("approver_id") @db.VarChar(36)
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  days        Int         @default(1)
  status      LeaveStatus @default(pending)
  reason      String?     @db.Text
  approvedAt  DateTime?   @map("approved_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])   // Perf: pending leave count dashboard
  @@index([tenantId, employeeId]) // Perf: per-employee leave history
  @@map("leave_requests")
}

model PayrollRun {
  id          String        @id @default(uuid()) @db.VarChar(36)
  tenantId    String        @map("tenant_id") @db.VarChar(36)
  periodMonth Int           @map("period_month")
  periodYear  Int           @map("period_year")
  totalAmount Decimal?      @map("total_amount") @db.Decimal(15, 2)
  status      PayrollStatus @default(draft)
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([tenantId, status])  // Perf: payroll run listing
  @@index([tenantId, periodYear, periodMonth]) // Perf: period-based lookup
  @@map("payroll_runs")
}

model Payslip {
  id           String      @id @default(uuid()) @db.VarChar(36)
  tenantId     String      @map("tenant_id") @db.VarChar(36)
  payrollRunId String?     @map("payroll_run_id") @db.VarChar(36)
  employeeId   String      @map("employee_id") @db.VarChar(36)
  periodMonth  Int         @map("period_month")
  periodYear   Int         @map("period_year")
  grossSalary  Decimal     @map("gross_salary") @db.Decimal(12, 2)
  deductions   Decimal     @default(0.00) @db.Decimal(12, 2)
  netSalary    Decimal     @map("net_salary") @db.Decimal(12, 2)
  breakdown    Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

model CmsPage {
  id              String   @id @default(uuid()) @db.VarChar(36)
  slug            String   @unique @db.VarChar(191)
  title           String   @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.VarChar(500)
  published       Boolean  @default(true)
  content         Json
  updatedBy       String?  @map("updated_by") @db.VarChar(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

// ==========================================
// RELATIONAL SUBSCRIPTION & POLICY CONTROLS
// ==========================================
// These models replace the legacy CMS JSON subscription records.  The legacy
// records remain readable during the staged migration so existing workspaces
// are never silently assigned or disabled.
model SubscriptionPlan {
  id               String   @id @default(uuid()) @db.VarChar(100)
  name             String   @db.VarChar(255)
  description      String?  @db.Text
  status           String   @default("active") @db.VarChar(30)
  priceMonthly     Decimal  @default(0) @map("price_monthly") @db.Decimal(16, 3)
  priceAnnual      Decimal  @default(0) @map("price_annual") @db.Decimal(16, 3)
  maxEmployees     Int?     @map("max_employees")
  maxUsers         Int?     @map("max_users")
  features         Json?
  includedAddonIds Json?    @map("included_addon_ids")
  isPopular        Boolean  @default(false) @map("is_popular")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model TenantSubscription {
  id           String   @id @default(uuid()) @db.VarChar(36)
  tenantId     String   @unique @map("tenant_id") @db.VarChar(36)
  planId       String?  @map("plan_id") @db.VarChar(100)
  status       String   @default("active") @db.VarChar(30)
  billingCycle String   @default("monthly") @map("billing_cycle") @db.VarChar(20)
  maxEmployees Int?     @map("max_employees")
  maxUsers     Int?     @map("max_users")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  policyAudits SubscriptionPolicyAudit[]

  @@index([planId, status])
  @@map("tenant_subscriptions")
}

model SubscriptionPolicyAudit {
  id             String   @id @default(uuid()) @db.VarChar(36)
  tenantId       String   @map("tenant_id") @db.VarChar(36)
  subscriptionId String?  @map("subscription_id") @db.VarChar(36)
  actorUserId    String   @map("actor_user_id") @db.VarChar(36)
  before         Json?
  after          Json
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("subscription_policy_audits")
}

model Addon {
  id              String   @id @default(uuid()) @db.VarChar(36)
  name            String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(100)
  tagline         String?  @db.VarChar(300)
  description     String?  @db.Text
  longDescription String?  @map("long_description") @db.LongText
  category        String   @db.VarChar(100)
  status          String   @default("active") @db.VarChar(50)
  priceMonthly    Decimal  @default(0.00) @map("price_monthly") @db.Decimal(10, 2)
  icon            String?  @db.VarChar(500)
  screenshots     Json?
  features        Json?
  developer       String?  @db.VarChar(255)
  version         String?  @db.VarChar(50)
  docsUrl         String?  @map("docs_url") @db.VarChar(500)
  galleryVideo    String?  @map("gallery_video") @db.VarChar(500)
  installUrl      String?  @map("install_url") @db.VarChar(500)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("addons")
}

// ==========================================
// SAAS ADD-ON ENTITLEMENTS
// ==========================================
model TenantAddon {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  addonSlug   String    @map("addon_slug") @db.VarChar(100)
  status      String    @default("active") @db.VarChar(50) // trial, active, past_due, cancelled, expired
  plan        String    @default("standard") @db.VarChar(50)
  trialEndsAt DateTime? @map("trial_ends_at")
  renewsAt    DateTime? @map("renews_at")
  features    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonSlug])
  @@index([tenantId, status])
  @@map("tenant_addons")
}

// ==========================================
// OKR & PERFORMANCE ADD-ON
// ==========================================
model OkrCycle {
  id         String   @id @default(uuid()) @db.VarChar(36)
  tenantId   String   @map("tenant_id") @db.VarChar(36)
  name       String   @db.VarChar(255)
  periodType String   @default("quarterly") @map("period_type") @db.VarChar(50)
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  status     String   @default("active") @db.VarChar(50) // draft, active, closed
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectives OkrObjective[]
  reviews    OkrReview[]

  @@map("okr_cycles")
}

model OkrObjective {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  cycleId       String   @map("cycle_id") @db.VarChar(36)
  parentId      String?  @map("parent_id") @db.VarChar(36)
  category      String?  @default("Strategy") @db.VarChar(100)
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  ownerId       String   @map("owner_id") @db.VarChar(36)
  departmentId  String?  @map("department_id") @db.VarChar(36)
  alignmentType String   @default("individual") @map("alignment_type") @db.VarChar(50) // company, department, team, individual
  progress      Decimal  @default(0.00) @db.Decimal(5, 2)
  status        String   @default("in_progress") @db.VarChar(50) // not_started, in_progress, achieved, closed
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle      OkrCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  parent     OkrObjective?  @relation("ObjectiveHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   OkrObjective[] @relation("ObjectiveHierarchy")
  owner      Employee       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  keyResults OkrKeyResult[]

  @@index([tenantId, cycleId])
  @@index([tenantId, ownerId])
  @@index([tenantId, parentId])
  @@map("okr_objectives")
}

model OkrKeyResult {
  id              String   @id @default(uuid()) @db.VarChar(36)
  objectiveId     String   @map("objective_id") @db.VarChar(36)
  title           String   @db.VarChar(255)
  measurementType String   @default("percentage") @map("measurement_type") @db.VarChar(50) // number, percentage, currency, boolean
  startValue      Decimal  @default(0.00) @map("start_value") @db.Decimal(12, 2)
  targetValue     Decimal  @default(100.00) @map("target_value") @db.Decimal(12, 2)
  currentValue    Decimal  @default(0.00) @map("current_value") @db.Decimal(12, 2)
  weight          Decimal  @default(1.00) @db.Decimal(3, 2)
  status          String   @default("in_progress") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  objective OkrObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  checkins  OkrCheckin[]

  @@map("okr_key_results")
}

model OkrCheckin {
  id              String   @id @default(uuid()) @db.VarChar(36)
  keyResultId     String   @map("key_result_id") @db.VarChar(36)
  employeeId      String   @map("employee_id") @db.VarChar(36)
  progressValue   Decimal  @map("progress_value") @db.Decimal(12, 2)
  confidenceScore Int      @default(8) @map("confidence_score") // 1-10
  notes           String?  @db.Text
  blockers        String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  keyResult OkrKeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("okr_checkins")
}

model OkrReview {
  id           String   @id @default(uuid()) @db.VarChar(36)
  cycleId      String   @map("cycle_id") @db.VarChar(36)
  employeeId   String   @map("employee_id") @db.VarChar(36)
  reviewerId   String   @map("reviewer_id") @db.VarChar(36)
  reviewType   String   @default("manager") @map("review_type") @db.VarChar(50) // self, manager, peer_360
  ratingScore  Decimal? @map("rating_score") @db.Decimal(3, 1) // e.g. 4.5 / 5.0
  feedbackText String?  @map("feedback_text") @db.Text
  status       String   @default("pending") @db.VarChar(50) // pending, submitted, approved
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cycle    OkrCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee @relation("OkrReviewsReceived", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee @relation("OkrReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@map("okr_reviews")
}

// ==========================================
// ASSET MANAGEMENT ADD-ON
// ==========================================
model AssetCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @default("💻") @db.VarChar(50)
  prefix      String   @default("AST") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@unique([tenantId, slug])
  @@map("asset_categories")
}

model Asset {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  tenantId           String    @map("tenant_id") @db.VarChar(36)
  assetTag           String    @map("asset_tag") @db.VarChar(100)
  name               String    @db.VarChar(255)
  category           String    @default("laptop") @db.VarChar(100)
  categoryId         String?   @map("category_id") @db.VarChar(36)
  brand              String?   @db.VarChar(100)
  model              String?   @db.VarChar(100)
  serialNumber       String?   @map("serial_number") @db.VarChar(150)
  isBatch            Boolean   @default(false) @map("is_batch")
  totalQuantity      Int       @default(1) @map("total_quantity")
  availableQuantity  Int       @default(1) @map("available_quantity")
  unit               String    @default("pcs") @db.VarChar(50)
  location           String?   @db.VarChar(150)
  images             Json?
  qrCode             String?   @map("qr_code") @db.VarChar(255)
  purchaseDate       DateTime? @map("purchase_date") @db.Date
  purchasePrice      Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  vendor             String?   @db.VarChar(150)
  warrantyExpiry     DateTime? @map("warranty_expiry") @db.Date
  condition          String    @default("good") @db.VarChar(50) // new, good, fair, damaged
  status             String    @default("available") @db.VarChar(50) // available, assigned, maintenance, retired, lost, disposed
  assignedEmployeeId String?   @map("assigned_employee_id") @db.VarChar(36)
  assignedAt         DateTime? @map("assigned_at")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRel      AssetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedEmployee Employee?           @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignments      AssetAssignment[]
  maintenanceLogs  AssetMaintenance[]
  disposalItems    AssetDisposalItem[]
  activityLogs     AssetActivityLog[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("assets")
}

model AssetAssignment {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  assetId            String    @map("asset_id") @db.VarChar(36)
  employeeId         String?   @map("employee_id") @db.VarChar(36)
  departmentId       String?   @map("department_id") @db.VarChar(36)
