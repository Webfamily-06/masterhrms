model Brand {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  name        String    @db.VarChar(150)
  description String?   @db.Text
  image       String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("brands")
}

model Unit {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tenantId  String    @map("tenant_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  shortName String?   @map("short_name") @db.VarChar(30)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("units")
}

model TaxRate {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tenantId  String    @map("tenant_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  rate      Decimal   @default(0.00) @db.Decimal(5, 2)
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("tax_rates")
}

model Warehouse {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  name        String    @db.VarChar(150)
  location    String?   @db.VarChar(255)
  city        String?   @db.VarChar(100)
  phone       String?   @db.VarChar(50)
  email       String?   @db.VarChar(150)
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks            ProductWarehouse[]
  sales             Sale[]
  purchases         Purchase[]
  transfersFrom     StockTransfer[]    @relation("TransferFromWarehouse")
  transfersTo       StockTransfer[]    @relation("TransferToWarehouse")
  stockAdjustments  StockAdjustment[]
  cashRegisters     CashRegister[]

  @@map("warehouses")
}

model Product {
  id                String    @id @default(uuid()) @db.VarChar(36)
  tenantId          String    @map("tenant_id") @db.VarChar(36)
  name              String    @db.VarChar(255)
  type              String    @default("Product") @db.VarChar(50)
  sku               String    @db.VarChar(100)
  barcode           String?   @db.VarChar(100)
  hsnSac            String?   @map("hsn_sac") @db.VarChar(50)
  categoryId        String?   @map("category_id") @db.VarChar(36)
  brandId           String?   @map("brand_id") @db.VarChar(36)
  unitId            String?   @map("unit_id") @db.VarChar(36)
  taxRateId         String?   @map("tax_rate_id") @db.VarChar(36)
  salePrice         Decimal   @default(0.00) @map("sale_price") @db.Decimal(15, 2)
  purchasePrice     Decimal   @default(0.00) @map("purchase_price") @db.Decimal(15, 2)
  lowStockThreshold Int       @default(5) @map("low_stock_threshold")
  image             String?   @db.VarChar(500)
  additionalImages  Json?     @map("additional_images")
  shortDescription  String?   @map("short_description") @db.VarChar(500)
  description       String?   @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand             Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit              Unit?                   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  taxRate           TaxRate?                @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  warehouseStocks   ProductWarehouse[]
  saleDetails       SaleDetail[]
  purchaseDetails   PurchaseDetail[]
  transferDetails   StockTransferDetail[]
  adjustmentDetails StockAdjustmentDetail[]

  @@unique([tenantId, sku])
  @@map("products")
}

model ProductWarehouse {
  id          String   @id @default(uuid()) @db.VarChar(36)
  productId   String   @map("product_id") @db.VarChar(36)
  warehouseId String   @map("warehouse_id") @db.VarChar(36)
  quantity    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("product_warehouses")
}

// ==========================================
// COMMERCIAL CONTACTS
// ==========================================

model Customer {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  name        String    @db.VarChar(255)
  email       String?   @db.VarChar(150)
  phone       String?   @db.VarChar(50)
  gstin       String?   @db.VarChar(50)
  address     String?   @db.Text
  city        String?   @db.VarChar(100)
  state       String?   @db.VarChar(100)
  country     String?   @default("India") @db.VarChar(100)
  postalCode  String?   @map("postal_code") @db.VarChar(30)
  creditLimit Decimal?  @map("credit_limit") @db.Decimal(15, 2)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@map("customers")
}

model Supplier {
  id          String     @id @default(uuid()) @db.VarChar(36)
  tenantId    String     @map("tenant_id") @db.VarChar(36)
  name        String     @db.VarChar(255)
  email       String?    @db.VarChar(150)
  phone       String?    @db.VarChar(50)
  gstin       String?    @db.VarChar(50)
  address     String?    @db.Text
  city        String?    @db.VarChar(100)
  country     String?    @default("India") @db.VarChar(100)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@map("suppliers")
}

// ==========================================
// SALES & POS INVOICING
// ==========================================

model Sale {
  id             String        @id @default(uuid()) @db.VarChar(36)
  tenantId       String        @map("tenant_id") @db.VarChar(36)
  invoiceNo      String        @map("invoice_no") @db.VarChar(100)
  type           String        @default("pos") @db.VarChar(30)
  customerId     String?       @map("customer_id") @db.VarChar(36)
  customerName   String?       @map("customer_name") @db.VarChar(255)
  customerGstin  String?       @map("customer_gstin") @db.VarChar(50)
  warehouseId    String?       @map("warehouse_id") @db.VarChar(36)
  cashierId      String?       @map("cashier_id") @db.VarChar(36)
  cashierName    String?       @map("cashier_name") @db.VarChar(150)
  subtotal       Decimal       @default(0.00) @db.Decimal(15, 2)
  discountPct    Decimal?      @map("discount_pct") @db.Decimal(5, 2)
  discountAmt    Decimal       @default(0.00) @map("discount_amt") @db.Decimal(15, 2)
  taxMode        String?       @default("sgst_cgst") @map("tax_mode") @db.VarChar(30)
  cgst           Decimal       @default(0.00) @db.Decimal(15, 2)
  sgst           Decimal       @default(0.00) @db.Decimal(15, 2)
  igst           Decimal       @default(0.00) @db.Decimal(15, 2)
  totalTax       Decimal       @default(0.00) @map("total_tax") @db.Decimal(15, 2)
  total          Decimal       @default(0.00) @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus  String        @default("paid") @map("payment_status") @db.VarChar(30)
  paymentMethod  String        @default("Cash") @map("payment_method") @db.VarChar(50)
  notes          String?       @db.Text
  date           DateTime      @default(now())
  dueDate        DateTime?     @map("due_date")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  details   SaleDetail[]
  payments  SalePayment[]
  gatewayTransactions PaymentGatewayTransaction[]

  @@unique([tenantId, invoiceNo])
  @@map("sales")
}

model SaleDetail {
  id          String   @id @default(uuid()) @db.VarChar(36)
  saleId      String   @map("sale_id") @db.VarChar(36)
  productId   String   @map("product_id") @db.VarChar(36)
  productName String   @map("product_name") @db.VarChar(255)
  sku         String?  @db.VarChar(100)
  hsnSac      String?  @map("hsn_sac") @db.VarChar(50)
  unit        String?  @db.VarChar(30)
  price       Decimal  @default(0.00) @db.Decimal(15, 2)
  quantity    Int      @default(1)
  taxRate     Decimal  @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  discount    Decimal  @default(0.00) @db.Decimal(15, 2)
  subtotal    Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_details")
}

model SalePayment {
  id          String   @id @default(uuid()) @db.VarChar(36)
  saleId      String   @map("sale_id") @db.VarChar(36)
  amount      Decimal  @db.Decimal(15, 2)
  method      String   @default("Cash") @db.VarChar(50)
  referenceNo String?  @map("reference_no") @db.VarChar(100)
  paidAt      DateTime @default(now()) @map("paid_at")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

// Immutable, tenant-scoped gateway trail. Gateway credentials remain in the
// existing protected configuration store; payment evidence never does.
model PaymentGatewayTransaction {
  id                String   @id @default(uuid()) @db.VarChar(36)
  tenantId          String   @map("tenant_id") @db.VarChar(36)
  saleId            String?  @map("sale_id") @db.VarChar(36)
  provider          String   @db.VarChar(30)
  providerOrderId   String   @map("provider_order_id") @db.VarChar(120)
  providerPaymentId String?  @unique @map("provider_payment_id") @db.VarChar(120)
  amount            Decimal  @db.Decimal(16, 3)
  currency          String   @default("INR") @db.VarChar(10)
  status            String   @db.VarChar(30)
  method            String?  @db.VarChar(50)
  verifiedAt        DateTime? @map("verified_at")
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerOrderId])
  @@index([tenantId, status, createdAt])
  @@map("payment_gateway_transactions")
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String?  @map("tenant_id") @db.VarChar(36)
  provider    String   @db.VarChar(30)
  deliveryKey String   @unique @map("delivery_key") @db.VarChar(64)
  eventType   String   @map("event_type") @db.VarChar(100)
  signatureOk Boolean  @default(false) @map("signature_ok")
  payload     Json
  receivedAt  DateTime @default(now()) @map("received_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, provider, receivedAt])
  @@map("payment_webhook_events")
}

model HeldOrder {
  id           String   @id @default(uuid()) @db.VarChar(36)
  tenantId     String   @map("tenant_id") @db.VarChar(36)
  label        String?  @db.VarChar(100)
  customerName String?  @map("customer_name") @db.VarChar(255)
  cartData     Json     @map("cart_data")
  heldAt       DateTime @default(now()) @map("held_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("held_orders")
}

// ==========================================
// PURCHASES & INVENTORY TRANSFERS
// ==========================================

model Purchase {
  id            String           @id @default(uuid()) @db.VarChar(36)
  tenantId      String           @map("tenant_id") @db.VarChar(36)
  purchaseNo    String           @map("purchase_no") @db.VarChar(100)
  supplierId    String?          @map("supplier_id") @db.VarChar(36)
  warehouseId   String?          @map("warehouse_id") @db.VarChar(36)
  status        String           @default("received") @db.VarChar(30)
  total         Decimal          @default(0.00) @db.Decimal(15, 2)
  paidAmount    Decimal          @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus String           @default("unpaid") @map("payment_status") @db.VarChar(30)
  notes         String?          @db.Text
  date          DateTime         @default(now())
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  details   PurchaseDetail[]

  @@unique([tenantId, purchaseNo])
  @@map("purchases")
}

model PurchaseDetail {
  id          String   @id @default(uuid()) @db.VarChar(36)
  purchaseId  String   @map("purchase_id") @db.VarChar(36)
  productId   String   @map("product_id") @db.VarChar(36)
  productName String   @map("product_name") @db.VarChar(255)
  cost        Decimal  @default(0.00) @db.Decimal(15, 2)
  quantity    Int      @default(1)
  taxRate     Decimal  @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_details")
}

model StockTransfer {
  id              String                @id @default(uuid()) @db.VarChar(36)
  tenantId        String                @map("tenant_id") @db.VarChar(36)
  transferNo      String                @map("transfer_no") @db.VarChar(100)
  fromWarehouseId String                @map("from_warehouse_id") @db.VarChar(36)
  toWarehouseId   String                @map("to_warehouse_id") @db.VarChar(36)
  status          String                @default("completed") @db.VarChar(30)
  notes           String?               @db.Text
  date            DateTime              @default(now())
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse             @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse             @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  details       StockTransferDetail[]

  @@unique([tenantId, transferNo])
  @@map("stock_transfers")
}

model StockTransferDetail {
  id         String   @id @default(uuid()) @db.VarChar(36)
  transferId String   @map("transfer_id") @db.VarChar(36)
  productId  String   @map("product_id") @db.VarChar(36)
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_transfer_details")
}

model StockAdjustment {
  id          String                  @id @default(uuid()) @db.VarChar(36)
  tenantId    String                  @map("tenant_id") @db.VarChar(36)
  warehouseId String                  @map("warehouse_id") @db.VarChar(36)
  type        String                  @default("addition") @db.VarChar(30)
  reason      String?                 @db.VarChar(255)
  date        DateTime                @default(now())
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  details   StockAdjustmentDetail[]

  @@map("stock_adjustments")
}

model StockAdjustmentDetail {
  id           String   @id @default(uuid()) @db.VarChar(36)
  adjustmentId String   @map("adjustment_id") @db.VarChar(36)
  productId    String   @map("product_id") @db.VarChar(36)
  quantity     Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_adjustment_details")
}

model ChatMessage {
  id           String   @id @default(uuid()) @db.VarChar(36)
  tenantId     String   @map("tenant_id") @db.VarChar(36)
  threadId     String   @map("thread_id") @db.VarChar(100)
  senderId     String   @map("sender_id") @db.VarChar(36)
  senderName   String   @map("sender_name") @db.VarChar(150)
  senderAvatar String?  @map("sender_avatar") @db.VarChar(500)
  content      String   @db.Text
  attachments  Json?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, threadId])
  @@map("chat_messages")
}


// ==========================================
// WORKSPACE ADMIN ROLES & PERMISSIONS (RBAC)
// ==========================================

model WorkspaceRole {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@unique([tenantId, name])
  @@map("workspace_roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module, resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.VarChar(36)
  roleId       String   @map("role_id") @db.VarChar(36)
  permissionId String   @map("permission_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")

  role       WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    String   @map("role_id") @db.VarChar(36)
  tenantId  String   @map("tenant_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("user_role_assignments")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.VarChar(36)
  tenantId  String   @map("tenant_id") @db.VarChar(36)
  moduleKey String   @map("module_key") @db.VarChar(50)
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@map("tenant_modules")
}

model TwoFactorOtp {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @map("user_id") @db.VarChar(36)
  codeHash     String    @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  usedAt       DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_otps")
}

// ==========================================
// CRM PIPELINE & LEADS
// ==========================================
model CrmLead {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  title       String    @db.VarChar(200)
  contactName String    @map("contact_name") @db.VarChar(150)
  email       String?   @db.VarChar(150)
  phone       String?   @db.VarChar(50)
  company     String?   @db.VarChar(150)
  stage       String    @default("new") @db.VarChar(50)
  value       Decimal   @default(0.00) @db.Decimal(15, 2)
  priority    String    @default("medium") @db.VarChar(20)
  source      String?   @db.VarChar(100)
  notes       String?   @db.Text
  assignedTo  String?   @map("assigned_to") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("crm_leads")
}

model CrmProposal {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  proposalNo  String    @map("proposal_no") @db.VarChar(50)
  title       String    @db.VarChar(200)
  clientName  String    @map("client_name") @db.VarChar(150)
  clientEmail String?   @map("client_email") @db.VarChar(150)
  clientGstin String?   @map("client_gstin") @db.VarChar(50)
  status      String    @default("draft") @db.VarChar(50)
  amount      Decimal   @default(0.00) @db.Decimal(15, 2)
  validUntil  DateTime? @map("valid_until")
  items       Json?
  terms       String?   @db.Text
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("crm_proposals")
}

// ==========================================
// PROJECTS & TASK BOARDS
// ==========================================
model Project {
  id          String        @id @default(uuid()) @db.VarChar(36)
  tenantId    String        @map("tenant_id") @db.VarChar(36)
  name        String        @db.VarChar(200)
  description String?       @db.Text
  status      String        @default("in_progress") @db.VarChar(50)
  priority    String        @default("medium") @db.VarChar(20)
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  budget      Decimal?      @default(0.00) @db.Decimal(15, 2)
  progress    Int           @default(0)
  clientName  String?       @map("client_name") @db.VarChar(150)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  ProjectTask[]

  @@map("projects")
}

model ProjectTask {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  projectId   String    @map("project_id") @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  status      String    @default("todo") @db.VarChar(50)
  priority    String    @default("medium") @db.VarChar(20)
  assignedTo  String?   @map("assigned_to") @db.VarChar(150)
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}

// ==========================================
// POS HARDWARE: CASH REGISTER & SHIFTS
// ==========================================
model CashRegister {
  id          String          @id @default(uuid()) @db.VarChar(36)
  tenantId    String          @map("tenant_id") @db.VarChar(36)
  warehouseId String?         @map("warehouse_id") @db.VarChar(36)
  name        String          @db.VarChar(100)
  status      String          @default("closed") @db.VarChar(20)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  shifts    RegisterShift[]

  @@map("cash_registers")
}

model RegisterShift {
  id           String        @id @default(uuid()) @db.VarChar(36)
  tenantId     String        @map("tenant_id") @db.VarChar(36)
  registerId   String        @map("register_id") @db.VarChar(36)
  cashierId    String?       @map("cashier_id") @db.VarChar(36)
  cashierName  String        @map("cashier_name") @db.VarChar(150)
  openingFloat Decimal       @default(0.00) @map("opening_float") @db.Decimal(15, 2)
  cashSales    Decimal       @default(0.00) @map("cash_sales") @db.Decimal(15, 2)
  cardSales    Decimal       @default(0.00) @map("card_sales") @db.Decimal(15, 2)
  upiSales     Decimal       @default(0.00) @map("upi_sales") @db.Decimal(15, 2)
  cashIn       Decimal       @default(0.00) @map("cash_in") @db.Decimal(15, 2)
  cashOut      Decimal       @default(0.00) @map("cash_out") @db.Decimal(15, 2)
  expectedCash Decimal       @default(0.00) @map("expected_cash") @db.Decimal(15, 2)
  actualCash   Decimal?      @map("actual_cash") @db.Decimal(15, 2)
  variance     Decimal?      @db.Decimal(15, 2)
  status       String        @default("open") @db.VarChar(20)
  openedAt     DateTime      @default(now()) @map("opened_at")
  closedAt     DateTime?     @map("closed_at")
  notes        String?       @db.Text

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@map("register_shifts")
}
