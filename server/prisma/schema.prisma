  monthlyLimit    Decimal?       @map("monthly_limit") @db.Decimal(12, 2)
  requiresReceipt Boolean        @default(true) @map("requires_receipt")
  icon            String         @default("Receipt") @db.VarChar(50)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claims ExpenseClaim[]

  @@unique([tenantId, code])
  @@map("expense_categories")
}

model ExpenseClaim {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  tenantId            String    @map("tenant_id") @db.VarChar(36)
  employeeId          String    @map("employee_id") @db.VarChar(36)
  categoryId          String    @map("category_id") @db.VarChar(36)
  claimCode           String    @map("claim_code") @db.VarChar(50)
  title               String    @db.VarChar(200)
  amount              Decimal   @db.Decimal(12, 2)
  expenseDate         DateTime  @map("expense_date") @db.Date
  merchant            String    @db.VarChar(150)
  description         String?   @db.Text
  receiptUrl          String?   @map("receipt_url") @db.VarChar(500)
  receiptName         String?   @map("receipt_name") @db.VarChar(200)
  status              String    @default("pending") @db.VarChar(50) // pending, manager_approved, finance_approved, reimbursed, rejected
  reimbursementMethod String?   @map("reimbursement_method") @db.VarChar(50) // payroll_addition, direct_bank_transfer, petty_cash
  payrollMonth        String?   @map("payroll_month") @db.VarChar(20) // e.g. 2026-08
  approverNotes       String?   @map("approver_notes") @db.Text
  approvedAt          DateTime? @map("approved_at")
  reimbursedAt        DateTime? @map("reimbursed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("expense_claims")
