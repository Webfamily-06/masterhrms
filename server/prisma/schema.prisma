// Immutable, tenant-scoped gateway trail. Gateway credentials remain in the
// existing protected configuration store; payment evidence never does.
model PaymentGatewayTransaction {
  id                String   @id @default(uuid()) @db.VarChar(36)
  tenantId          String   @map("tenant_id") @db.VarChar(36)
  saleId            String?  @map("sale_id") @db.VarChar(36)
  provider          String   @db.VarChar(30)
  providerOrderId   String   @map("provider_order_id") @db.VarChar(120)
  providerPaymentId String?  @unique @map("provider_payment_id") @db.VarChar(120)
  amount            Decimal  @db.Decimal(16, 3)
  currency          String   @default("INR") @db.VarChar(10)
  status            String   @db.VarChar(30)
  method            String?  @db.VarChar(50)
  verifiedAt        DateTime? @map("verified_at")
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerOrderId])
  @@index([tenantId, status, createdAt])
  @@map("payment_gateway_transactions")
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String?  @map("tenant_id") @db.VarChar(36)
