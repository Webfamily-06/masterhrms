}

// ==========================================
// PURCHASES & INVENTORY TRANSFERS
// ==========================================

model Purchase {
  id            String           @id @default(uuid()) @db.VarChar(36)
  tenantId      String           @map("tenant_id") @db.VarChar(36)
  purchaseNo    String           @map("purchase_no") @db.VarChar(100)
  supplierId    String?          @map("supplier_id") @db.VarChar(36)
  warehouseId   String?          @map("warehouse_id") @db.VarChar(36)
  status        String           @default("received") @db.VarChar(30)
  total         Decimal          @default(0.00) @db.Decimal(15, 2)
  paidAmount    Decimal          @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus String           @default("unpaid") @map("payment_status") @db.VarChar(30)
  notes         String?          @db.Text
  date          DateTime         @default(now())
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  details   PurchaseDetail[]
  payments  PurchasePayment[]
  purchaseReturns PurchaseReturn[]
  debitNotes      DebitNote[]

  @@unique([tenantId, purchaseNo])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, paymentStatus])
  @@map("purchases")
}

model PurchaseDetail {
  id          String   @id @default(uuid()) @db.VarChar(36)
  purchaseId  String   @map("purchase_id") @db.VarChar(36)
  productId   String   @map("product_id") @db.VarChar(36)
  productName String   @map("product_name") @db.VarChar(255)
  cost        Decimal  @default(0.00) @db.Decimal(15, 2)
  quantity    Int      @default(1)
  taxRate     Decimal  @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  subtotal    Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReturnDetails PurchaseReturnDetail[]

  @@map("purchase_details")
}

// Discrete payment installment ledger for purchase orders / Accounts Payable.
// Every call to POST /api/purchases/:id/payments creates one row here,
// mirroring SalePayment. Idempotency is enforced via @@unique([purchaseId, idempotencyKey]).
model PurchasePayment {
  id             String   @id @default(uuid()) @db.VarChar(36)
  purchaseId     String   @map("purchase_id") @db.VarChar(36)
  tenantId       String   @map("tenant_id") @db.VarChar(36)
  amount         Decimal  @db.Decimal(15, 2)
  method         String   @default("Bank Transfer") @db.VarChar(50)
  referenceNo    String?  @map("reference_no") @db.VarChar(100)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(128)
  notes          String?  @db.VarChar(255)
  paidAt         DateTime @default(now()) @map("paid_at")
  createdById    String?  @map("created_by_id") @db.VarChar(36)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, idempotencyKey])
  @@index([tenantId, paidAt])
  @@map("purchase_payments")
}

model StockTransfer {
