// -------------------------------------------------------------
// TRAINING & LMS ACADEMY SUITE
// -------------------------------------------------------------

model TrainingCourse {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @map("tenant_id") @db.VarChar(36)
  title         String   @db.VarChar(200)
  slug          String   @db.VarChar(200)
  category      String   @default("Compliance & Security") @db.VarChar(100)
  instructor    String   @default("Internal Academy") @db.VarChar(150)
  durationHours Float    @default(4.0) @map("duration_hours")
  isMandatory   Boolean  @default(false) @map("is_mandatory")
  passingScore  Int      @default(80) @map("passing_score")
  description   String?  @db.Text
  bannerUrl     String?  @map("banner_url") @db.VarChar(500)
  status        String   @default("published") @db.VarChar(50) // draft, published, archived
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules     CourseModule[]
