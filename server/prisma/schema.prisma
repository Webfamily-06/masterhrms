// ==========================================
// RELATIONAL SUBSCRIPTION & POLICY CONTROLS
// ==========================================
// These models replace the legacy CMS JSON subscription records.  The legacy
// records remain readable during the staged migration so existing workspaces
// are never silently assigned or disabled.
model SubscriptionPlan {
  id                   String   @id @default(uuid()) @db.VarChar(100)
  name                 String   @db.VarChar(255)
  description          String?  @db.Text
  status               String   @default("active") @db.VarChar(30)
  planType             String   @default("standard") @map("plan_type") @db.VarChar(30) // standard | custom
  pricingModel         String   @default("fixed") @map("pricing_model") @db.VarChar(30) // fixed | per_user
  currency             String   @default("INR") @map("currency") @db.VarChar(10)
  priceMonthly         Decimal  @default(0) @map("price_monthly") @db.Decimal(16, 3) // Selling price monthly
  priceMonthlyOriginal Decimal? @map("price_monthly_original") @db.Decimal(16, 3) // List / original price monthly
  priceQuarterly       Decimal? @map("price_quarterly") @db.Decimal(16, 3)
  priceSemiAnnual      Decimal? @map("price_semi_annual") @db.Decimal(16, 3)
  priceAnnual          Decimal  @default(0) @map("price_annual") @db.Decimal(16, 3) // Selling price annual
  priceAnnualOriginal  Decimal? @map("price_annual_original") @db.Decimal(16, 3) // List / original price annual
  pricePerUser         Decimal? @map("price_per_user") @db.Decimal(16, 3) // Selling price per user
  pricePerUserOriginal Decimal? @map("price_per_user_original") @db.Decimal(16, 3) // Original price per user
  billableUsers        Int?     @default(1) @map("billable_users") // Default billable user count (1 - 99999)
  minUsers             Int?     @default(1) @map("min_users")
  maxUsersLimit        Int?     @default(99999) @map("max_users_limit")
  durationPrices       Json?    @map("duration_prices")
  isTrial              Boolean  @default(false) @map("is_trial")
  trialDays            Int?     @default(3) @map("trial_days")
  maxEmployees         Int?     @map("max_employees")
  maxUsers             Int?     @map("max_users")
  storageLimitGb       Int?     @map("storage_limit_gb")
  features             Json?
  includedAddonIds     Json?    @map("included_addon_ids")
  isPopular            Boolean  @default(false) @map("is_popular")
  sortOrder            Int      @default(0) @map("sort_order")
  isPublic             Boolean  @default(true) @map("is_public")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

