// ==========================================
// SALES & POS INVOICING
// ==========================================

model Sale {
  id             String        @id @default(uuid()) @db.VarChar(36)
  tenantId       String        @map("tenant_id") @db.VarChar(36)
  invoiceNo      String        @map("invoice_no") @db.VarChar(100)
  type           String        @default("pos") @db.VarChar(30)
  customerId     String?       @map("customer_id") @db.VarChar(36)
  customerName   String?       @map("customer_name") @db.VarChar(255)
  customerGstin  String?       @map("customer_gstin") @db.VarChar(50)
  warehouseId    String?       @map("warehouse_id") @db.VarChar(36)
  cashierId      String?       @map("cashier_id") @db.VarChar(36)
  cashierName    String?       @map("cashier_name") @db.VarChar(150)
  subtotal       Decimal       @default(0.00) @db.Decimal(15, 2)
  discountPct    Decimal?      @map("discount_pct") @db.Decimal(5, 2)
  discountAmt    Decimal       @default(0.00) @map("discount_amt") @db.Decimal(15, 2)
  taxMode        String?       @default("sgst_cgst") @map("tax_mode") @db.VarChar(30)
  cgst           Decimal       @default(0.00) @db.Decimal(15, 2)
  sgst           Decimal       @default(0.00) @db.Decimal(15, 2)
  igst           Decimal       @default(0.00) @db.Decimal(15, 2)
  totalTax       Decimal       @default(0.00) @map("total_tax") @db.Decimal(15, 2)
  total          Decimal       @default(0.00) @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus  String        @default("paid") @map("payment_status") @db.VarChar(30)
  paymentMethod  String        @default("Cash") @map("payment_method") @db.VarChar(50)
  notes          String?       @db.Text
  date           DateTime      @default(now())
  dueDate        DateTime?     @map("due_date")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  details   SaleDetail[]
  payments  SalePayment[]
  gatewayTransactions PaymentGatewayTransaction[]
  salesReturns SalesReturn[]
  creditNotes  CreditNote[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, date])
  @@index([tenantId, paymentStatus])
  @@map("sales")
}

model SaleDetail {
  id          String   @id @default(uuid()) @db.VarChar(36)
  saleId      String   @map("sale_id") @db.VarChar(36)
  productId   String   @map("product_id") @db.VarChar(36)
  productName String   @map("product_name") @db.VarChar(255)
  sku         String?  @db.VarChar(100)
  hsnSac      String?  @map("hsn_sac") @db.VarChar(50)
  unit        String?  @db.VarChar(30)
