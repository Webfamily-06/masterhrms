// -------------------------------------------------------------
// DYNAMIC CUSTOM FORMS, SURVEYS & PULSE POLLS ENGINE
// -------------------------------------------------------------

model CustomForm {
  id                       String    @id @default(uuid()) @db.VarChar(36)
  tenantId                 String    @map("tenant_id") @db.VarChar(36)
  title                    String    @db.VarChar(255)
  description              String?   @db.Text
  category                 String    @default("general") @db.VarChar(50) // pulse_survey, performance_review, it_request, employee_feedback, onboarding_checklist, general
  status                   String    @default("published") @db.VarChar(50) // draft, published, closed, archived
  targetAudience           String    @default("all_company") @map("target_audience") @db.VarChar(50) // all_company, department, specific_roles
  targetDepartmentId       String?   @map("target_department_id") @db.VarChar(36)
  isAnonymous              Boolean   @default(false) @map("is_anonymous")
  allowMultipleSubmissions Boolean   @default(false) @map("allow_multiple_submissions")
  deadline                 DateTime?
  authorId                 String?   @map("author_id") @db.VarChar(36)
  authorName               String    @default("HR Operations") @map("author_name") @db.VarChar(150)
  responseCount            Int       @default(0) @map("response_count")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetDepartment Department?      @relation(fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  author           Employee?        @relation("FormAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  fields           FormField[]
  submissions      FormSubmission[]

  @@index([tenantId, category])
  @@index([tenantId, status])
  @@map("custom_forms")
}

model FormField {
  id           String   @id @default(uuid()) @db.VarChar(36)
  formId       String   @map("form_id") @db.VarChar(36)
  label        String   @db.VarChar(255)
  description  String?  @db.VarChar(500)
  fieldType    String   @map("field_type") @db.VarChar(50) // short_text, long_text, number, select, radio, checkbox, rating_scale, date, file_upload
  options      String?  @db.Text // JSON array or comma-separated choices for select/radio/checkbox
  isRequired   Boolean  @default(true) @map("is_required")
  orderIndex   Int      @default(0) @map("order_index")
  placeholder  String?  @db.VarChar(255)
  defaultValue String?  @map("default_value") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  form           CustomForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseValues FormResponseValue[]

  @@index([formId, orderIndex])
  @@map("form_fields")
}

model FormSubmission {
  id            String    @id @default(uuid()) @db.VarChar(36)
  formId        String    @map("form_id") @db.VarChar(36)
  tenantId      String    @map("tenant_id") @db.VarChar(36)
  employeeId    String?   @map("employee_id") @db.VarChar(36) // null if anonymous
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  status        String    @default("submitted") @db.VarChar(50) // submitted, reviewed, approved, rejected
  reviewerNotes String?   @map("reviewer_notes") @db.Text
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  form           CustomForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  responseValues FormResponseValue[]

  @@index([formId])
  @@index([tenantId, formId])
  @@index([employeeId])
  @@map("form_submissions")
}

model FormResponseValue {
  id           String   @id @default(uuid()) @db.VarChar(36)
  submissionId String   @map("submission_id") @db.VarChar(36)
  fieldId      String   @map("field_id") @db.VarChar(36)
  fieldLabel   String   @map("field_label") @db.VarChar(255)
  value        String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([fieldId])
  @@map("form_response_values")
}

// -------------------------------------------------------------
// BIOMETRIC ATTENDANCE HARDWARE & PUNCH LOGS ENGINE
// -------------------------------------------------------------

model BiometricDevice {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  tenantId            String    @map("tenant_id") @db.VarChar(36)
  deviceName          String    @map("device_name") @db.VarChar(255)
  deviceModel         String    @default("ZKTeco MB20") @map("device_model") @db.VarChar(100)
  deviceType          String    @default("hybrid") @map("device_type") @db.VarChar(50) // fingerprint, face_recognition, rfid_card, palm_vein, hybrid
  purpose             String    @default("both") @map("purpose") @db.VarChar(20) // both | check_in_only | check_out_only
  ipAddress           String?   @map("ip_address") @db.VarChar(100)
  port                Int       @default(4370)
  serialNumber        String    @map("serial_number") @db.VarChar(100)
  location            String    @default("Main Entrance") @db.VarChar(150)
  status              String    @default("online") @db.VarChar(50) // online, offline, syncing, error
  syncProtocol        String    @default("push_api_webhook") @map("sync_protocol") @db.VarChar(50) // push_api_webhook, pull_tcp_ip, cloud_mqtt
  apiKey              String    @unique @map("api_key") @db.VarChar(100)
  lastSyncAt          DateTime? @map("last_sync_at")
  totalPunchLogs      Int       @default(0) @map("total_punch_logs")
  autoAttendanceSync  Boolean   @default(true) @map("auto_attendance_sync")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  punchLogs BiometricPunchLog[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId, status])
  @@map("biometric_devices")
}

model BiometricPunchLog {
  id               String   @id @default(uuid()) @db.VarChar(36)
  tenantId         String   @map("tenant_id") @db.VarChar(36)
  deviceId         String   @map("device_id") @db.VarChar(36)
  employeeCode     String   @map("employee_code") @db.VarChar(50)
  employeeId       String?  @map("employee_id") @db.VarChar(36)
  punchTime        DateTime @map("punch_time")
  punchType        String   @default("auto") @map("punch_type") @db.VarChar(50) // check_in, check_out, break_out, break_in, auto
  verificationMode String   @default("fingerprint") @map("verification_mode") @db.VarChar(50) // fingerprint, face, rfid, passcode
  syncStatus       String   @default("processed") @map("sync_status") @db.VarChar(50) // processed, pending, unmatched_employee
  rawPayload       String?  @map("raw_payload") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, punchTime])
  @@index([tenantId, syncStatus])
  @@index([deviceId])
  @@index([employeeCode])
  @@map("biometric_punch_logs")
}

// -------------------------------------------------------------
// DOUBLE-ENTRY GENERAL LEDGER & CHART OF ACCOUNTS
// -------------------------------------------------------------

model ChartOfAccount {
  id          String        @id @default(uuid()) @db.VarChar(36)
  tenantId    String        @map("tenant_id") @db.VarChar(36)
  accountCode String        @map("account_code") @db.VarChar(50)
  accountName String        @map("account_name") @db.VarChar(150)
  accountType String        @map("account_type") @db.VarChar(50) // asset, liability, equity, revenue, expense
  category    String        @default("current_asset") @db.VarChar(50) // current_asset, fixed_asset, current_liability, long_term_liability, equity, direct_income, indirect_income, direct_expense, indirect_expense
  currency    String        @default("INR") @db.VarChar(10)
  balance     Decimal       @default(0.00) @db.Decimal(15, 2)
  isSystem    Boolean       @default(false) @map("is_system")
  status      String        @default("active") @db.VarChar(20)
