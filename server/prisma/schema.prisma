generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "darwin-arm64", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String               @id @default(uuid()) @db.VarChar(36)
  email                    String               @unique @db.VarChar(255)
  passwordHash             String               @map("password_hash") @db.VarChar(255)
  twoFactorEnabled         Boolean              @default(false) @map("two_factor_enabled")
  twoFactorSecret          String?              @map("two_factor_secret") @db.VarChar(255)
  twoFactorBackupCodes     String?              @map("two_factor_backup_codes")
  twoFactorConfirmedAt     DateTime?            @map("two_factor_confirmed_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  calendarEvents           CalendarEvent[]
  commerceOrders           CommerceOrder[]
  employees                Employee[]
  loginHistories           LoginHistory[]
  notifications            Notification[]
  passwordResetTokens      PasswordResetToken[]
  profile                  Profile?
  twoFactorOtps            TwoFactorOtp[]
  workspaceRoleAssignments UserRoleAssignment[]
  roles                    UserRole[]
  workspaceNotes           WorkspaceNote[]
  workspaceTodos           WorkspaceTodo[]
  emailAccounts            UserEmailAccount[]

  @@map("users")
}

