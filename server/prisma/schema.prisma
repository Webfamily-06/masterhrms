model ShiftDefinition {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  tenantId           String        @map("tenant_id") @db.VarChar(36)
  name               String        @db.VarChar(100)
  code               String        @db.VarChar(20) // GEN, MORN, EVE, NIGHT, OFF
  startTime          String        @default("09:30") @map("start_time") @db.VarChar(10)
  endTime            String        @default("18:30") @map("end_time") @db.VarChar(10)
  breakMinutes       Int           @default(60) @map("break_minutes")
  allowance          Decimal       @default(0.00) @db.Decimal(10, 2)
  isOvertimeEligible Boolean       @default(true) @map("is_overtime_eligible")
  color              String        @default("blue") @db.VarChar(50)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rosters ShiftRoster[]

  @@index([tenantId, code])
  @@map("shift_definitions")
}

model ShiftRoster {
  id         String   @id @default(uuid()) @db.VarChar(36)
  tenantId   String   @map("tenant_id") @db.VarChar(36)
  employeeId String   @map("employee_id") @db.VarChar(36)
  shiftId    String   @map("shift_id") @db.VarChar(36)
  rosterDate DateTime @map("roster_date") @db.Date
  notes      String?  @db.VarChar(255)
  status     String   @default("assigned") @db.VarChar(50) // assigned, confirmed, swapped, leave
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    ShiftDefinition @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, rosterDate])
  @@index([tenantId, rosterDate])
  @@map("shift_rosters")
}

model ShiftSwapRequest {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  tenantId            String    @map("tenant_id") @db.VarChar(36)
  requesterEmployeeId String    @map("requester_employee_id") @db.VarChar(36)
  targetEmployeeId    String    @map("target_employee_id") @db.VarChar(36)
  shiftDate           DateTime  @map("shift_date") @db.Date
  reason              String    @db.Text
  status              String    @default("pending_peer") @db.VarChar(50) // pending_peer, pending_manager, approved, rejected
  managerNotes        String?   @map("manager_notes") @db.Text
  approvedAt          DateTime? @map("approved_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterEmployee Employee @relation("ShiftSwapsRequested", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  targetEmployee    Employee @relation("ShiftSwapsTargeted", fields: [targetEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("shift_swap_requests")
}

