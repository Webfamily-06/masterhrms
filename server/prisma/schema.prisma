  role        String?  @db.VarChar(100)
  company     String?  @db.VarChar(150)
  city        String?  @db.VarChar(100)
  country     String?  @default("India") @db.VarChar(100)
  rating      Decimal  @default(4.5) @db.Decimal(3, 1)
