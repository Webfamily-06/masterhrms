  ownerAvatar String?   @map("owner_avatar") @db.VarChar(500)
  status      String    @default("Open") @db.VarChar(30) // Open | Won | Lost
  notes       String?   @db.Text
  pipelineId  String?   @map("pipeline_id") @db.VarChar(50)
  leadId      String?   @map("lead_id") @db.VarChar(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

