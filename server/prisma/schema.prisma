datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

enum AppRole {
  super_admin
  hr_admin
  manager
  employee
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern
}

enum EmployeeStatus {
  active
  on_leave
  terminated
}

enum AttendanceStatus {
  present
  absent
  half_day
  late
  on_leave
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayrollStatus {
  draft
  processing
  completed
  paid
}

model User {
  id                    String     @id @default(uuid()) @db.VarChar(36)
  email                 String     @unique @db.VarChar(255)
  passwordHash          String     @map("password_hash") @db.VarChar(255)
  twoFactorEnabled      Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret       String?    @map("two_factor_secret") @db.VarChar(255)
  twoFactorBackupCodes  String?    @map("two_factor_backup_codes") @db.Text
  twoFactorConfirmedAt  DateTime?  @map("two_factor_confirmed_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  profile      Profile?
  roles        UserRole[]
  employees    Employee[]
  workspaceRoleAssignments UserRoleAssignment[]
  twoFactorOtps            TwoFactorOtp[]
  loginHistories           LoginHistory[]
  workspaceTodos           WorkspaceTodo[]
  workspaceNotes           WorkspaceNote[]
  calendarEvents           CalendarEvent[]

  @@map("users")
}

model Tenant {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  profiles      Profile[]
  userRoles     UserRole[]
  workspaceRoles         WorkspaceRole[]
  userRoleAssignments    UserRoleAssignment[]
  tenantModules          TenantModule[]
  departments   Department[]
  employees     Employee[]
  attendance    Attendance[]
  leaveTypes    LeaveType[]
  leaveRequests LeaveRequest[]
  payrollRuns   PayrollRun[]
  payslips      Payslip[]
  tenantAddons  TenantAddon[]
  subscription  TenantSubscription?
  billingInvoices BillingInvoice[]
  subscriptionPolicyAudits SubscriptionPolicyAudit[]
  couponRedemptions        CouponRedemption[]
  gatewayTransactions PaymentGatewayTransaction[]
  paymentWebhookEvents PaymentWebhookEvent[]
  okrCycles            OkrCycle[]
  okrObjectives        OkrObjective[]
  assets               Asset[]
  assetCategories      AssetCategory[]
  assetRequests        AssetRequest[]
  assetDisposalBatches AssetDisposalBatch[]
  assetActivityLogs    AssetActivityLog[]
  jobPostings          JobPosting[]
  jobCandidates        JobCandidate[]
  shiftDefinitions     ShiftDefinition[]
  shiftRosters         ShiftRoster[]
  shiftSwapRequests    ShiftSwapRequest[]
  expenseCategories    ExpenseCategory[]
  expenseClaims        ExpenseClaim[]
  trainingCourses      TrainingCourse[]
  courseEnrollments    CourseEnrollment[]
  employeeExits        EmployeeExit[]
  companyDocuments     CompanyDocument[]
  storedDocuments      StoredDocument[]
  campusCandidates     CampusCandidate[]
  employeeReferrals    EmployeeReferral[]
  helpdeskTickets        HelpdeskTicket[]
  platformSupportTickets PlatformSupportTicket[]
  announcements          Announcement[]
  customForms            CustomForm[]
  formSubmissions        FormSubmission[]
  biometricDevices         BiometricDevice[]
  biometricPunchLogs       BiometricPunchLog[]
  biometricEmployeeMappings BiometricEmployeeMapping[]
  biometricOfflineBuffers  BiometricOfflineBuffer[]
  bankDisbursementBatches  BankDisbursementBatch[]
  statutoryReturnFilings   StatutoryReturnFiling[]
  chartOfAccounts          ChartOfAccount[]
  fiscalYears            FiscalYear[]
  accountingPeriods      AccountingPeriod[]
  journalEntries         JournalEntry[]
  contracts              Contract[]
  budgetPlans            BudgetPlan[]
  financialGoals         FinancialGoal[]
  productCategories      ProductCategory[]
  brands                 Brand[]
  units                  Unit[]
  taxRates               TaxRate[]
  warehouses             Warehouse[]
  products               Product[]
  customers              Customer[]
  suppliers              Supplier[]
  sales                  Sale[]
  heldOrders             HeldOrder[]
  purchases              Purchase[]
  purchasePayments       PurchasePayment[]
  stockTransfers         StockTransfer[]
  stockAdjustments       StockAdjustment[]
  chatMessages           ChatMessage[]
  crmLeads               CrmLead[]
  crmDeals               CrmDeal[]
  crmProposals           CrmProposal[]
  crmContacts            CrmContact[]
  crmCompanies           CrmCompany[]
  projects               Project[]
  projectTasks           ProjectTask[]
  cashRegisters          CashRegister[]
  registerShifts         RegisterShift[]
  salaryComponents       SalaryComponent[]
  salaryStructures       SalaryStructure[]
  salaryAssignments      EmployeeSalaryAssignment[]
  statutoryRules         StatutoryRule[]
  taxDeclarations        EmployeeTaxDeclaration[]
  fbpDeclarations        FbpDeclaration[]
  payrollSnapshots       PayrollSnapshot[]
  genericFormTemplates   GenericFormTemplate[]
  stockMovements         StockMovement[]
  salesReturns           SalesReturn[]
  creditNotes            CreditNote[]
  purchaseReturns        PurchaseReturn[]
  debitNotes             DebitNote[]
  awardTypes             AwardType[]
  awards                 Award[]
  warningTypes           WarningType[]
  disciplinaryWarnings   DisciplinaryWarning[]
  automationRules        AutomationRule[]
  automationLogs         AutomationLog[]
  overtimeRequests       OvertimeRequest[]
  wfhRequests            WfhRequest[]
  promotionRecords       PromotionRecord[]
  probationRecords       ProbationRecord[]
  providentFundRecords   ProvidentFundRecord[]
  bannedIps              BannedIp[]
  callHistoryRecords     CallHistoryRecord[]
  recurringInvoices      RecurringInvoice[]
  customFields           CustomField[]
  customFieldValues      CustomFieldValue[]
  marketingCampaigns     MarketingCampaign[]
  branches               Branch[]
  designations           Designation[]
  contractTypes          ContractType[]
  employeeContracts      EmployeeContract[]
  establishments         Establishment[]
  staffingClients        StaffingClient[]
  payrollFormulas        PayrollFormula[]
  payrollExportTemplates PayrollExportTemplate[]
  payrollExecutionTraces PayrollExecutionTrace[]
  workspaceTodos         WorkspaceTodo[]
  workspaceNotes         WorkspaceNote[]
  calendarEvents         CalendarEvent[]
  tenantDomains          TenantDomain[]
  timesheets             Timesheet[]
  projectMilestones      ProjectMilestone[]
  workspaceSlugHistory   WorkspaceSlugHistory[]
  workspaceSlugRedirects WorkspaceSlugRedirect[]
  @@map("tenants")
}

model Profile {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @unique @map("user_id") @db.VarChar(36)
  email     String?  @db.VarChar(255)
  fullName  String?  @map("full_name") @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  tenantId  String?  @map("tenant_id") @db.VarChar(36)
  phone     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  role      AppRole  @default(employee)
  tenantId  String?  @map("tenant_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  @@unique([userId, role, tenantId])
  @@map("user_roles")
}

model Department {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  branchId    String?  @map("branch_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees     Employee[]
  designations  Designation[]
  jobPostings   JobPosting[]
  announcements Announcement[]
  customForms   CustomForm[]
  budgetPlans   BudgetPlan[]

  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid()) @db.VarChar(36)
  tenantId       String         @map("tenant_id") @db.VarChar(36)
  userId         String?        @map("user_id") @db.VarChar(36)
  departmentId   String?        @map("department_id") @db.VarChar(36)
  branchId       String?        @map("branch_id") @db.VarChar(36)
  designationId  String?        @map("designation_id") @db.VarChar(36)
  managerId      String?        @map("manager_id") @db.VarChar(36)
  employeeCode   String         @map("employee_code") @db.VarChar(50)
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String         @db.VarChar(255)
  phone          String?        @db.VarChar(50)
  position       String?        @db.VarChar(150)
  employmentType EmploymentType @default(full_time) @map("employment_type")
  status         EmployeeStatus @default(active)
  salary         Decimal?       @db.Decimal(12, 2)
  joinedAt       DateTime?      @map("joined_at")
  pan            String?        @db.VarChar(20)
  aadhaar        String?        @db.VarChar(20)
  uan            String?        @db.VarChar(20)
  esiNumber      String?        @map("esi_number") @db.VarChar(50)
  bankName       String?        @map("bank_name") @db.VarChar(100)
  bankAccount    String?        @map("bank_account") @db.VarChar(50)
  bankIfsc       String?        @map("bank_ifsc") @db.VarChar(20)
  bankBranch     String?        @map("bank_branch") @db.VarChar(100)
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date
  gender         String?        @db.VarChar(20)
  taxRegime           String         @default("new") @map("tax_regime") @db.VarChar(20)
  state               String?        @db.VarChar(100)
  workStateCode       String?        @map("work_state_code") @db.VarChar(10)
  establishmentId     String?        @map("establishment_id") @db.VarChar(36)
  clientId            String?        @map("client_id") @db.VarChar(36)
  pfNumber            String?        @map("pf_number") @db.VarChar(50)
  pfEligible          Boolean        @default(true) @map("pf_eligible")
  pfCalculationMethod String         @default("statutory_ceiling") @map("pf_calculation_method") @db.VarChar(50)
  pfCustomCap         Decimal?       @map("pf_custom_cap") @db.Decimal(12, 2)
  esiEligible         Boolean        @default(true) @map("esi_eligible")
  ptEligible          Boolean        @default(true) @map("pt_eligible")
  tdsEligible         Boolean        @default(true) @map("tds_eligible")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  tenant                      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  department                  Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch                      Branch?                       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  designation                 Designation?                  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  establishment               Establishment?                @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  client                      StaffingClient?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager                     Employee?                     @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates                Employee[]                    @relation("ManagerSubordinates")
  attendance                  Attendance[]
  leaveRequests               LeaveRequest[]
  payslips                    Payslip[]
  salaryAssignments           EmployeeSalaryAssignment[]
  taxDeclarations             EmployeeTaxDeclaration[]
  fbpDeclarations             FbpDeclaration[]
  payrollSnapshots            PayrollSnapshot[]
  okrObjectives               OkrObjective[]
  okrCheckins                 OkrCheckin[]
  okrReviewsReceived          OkrReview[]                   @relation("OkrReviewsReceived")
  okrReviewsGiven             OkrReview[]                   @relation("OkrReviewsGiven")
  assignedAssets              Asset[]
  assetAssignments            AssetAssignment[]
  assetRequests               AssetRequest[]
  conductedInterviews         JobCandidateInterview[]
  shiftRosters                ShiftRoster[]
  shiftSwapsRequested         ShiftSwapRequest[]            @relation("ShiftSwapsRequested")
  shiftSwapsTargeted          ShiftSwapRequest[]            @relation("ShiftSwapsTargeted")
  expenseClaims               ExpenseClaim[]
  courseEnrollments           CourseEnrollment[]
  employeeExits               EmployeeExit[]
  companyDocuments            CompanyDocument[]
  helpdeskTickets             HelpdeskTicket[]
  announcements               Announcement[]                @relation("AnnouncementAuthor")
  announcementAcknowledgements AnnouncementAcknowledgement[]
  authoredForms               CustomForm[]                  @relation("FormAuthor")
  formSubmissions             FormSubmission[]
  biometricPunchLogs          BiometricPunchLog[]
  biometricEmployeeMappings   BiometricEmployeeMapping[]
  awards                      Award[]
  disciplinaryWarnings        DisciplinaryWarning[]
  overtimeRequests            OvertimeRequest[]
  wfhRequests                 WfhRequest[]
  promotionRecords            PromotionRecord[]
  probationRecords            ProbationRecord[]
  providentFundRecords        ProvidentFundRecord[]
  campusRecruiterFor          CampusCandidate[]             @relation("CampusRecruiter")
  referralsGiven              EmployeeReferral[]            @relation("EmployeeReferralsGiven")
  employeeContracts           EmployeeContract[]
  bankDisbursementItems       BankDisbursementItem[]
  timesheets                  Timesheet[]

  @@index([tenantId, status])  // Perf: list active employees by tenant
  @@index([tenantId, departmentId]) // Perf: filter by department
  @@map("employees")
}

model Attendance {
  id         String           @id @default(uuid()) @db.VarChar(36)
  tenantId   String           @map("tenant_id") @db.VarChar(36)
  employeeId String           @map("employee_id") @db.VarChar(36)
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  hours      Decimal?         @db.Decimal(5, 2)
  status     AttendanceStatus @default(present)
  notes      String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])    // Perf: daily attendance summary
  @@index([tenantId, status])  // Perf: filter present/absent/late
  @@map("attendance")
}

model LeaveType {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  daysPerYear Int      @default(0) @map("days_per_year")
  color       String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id          String      @id @default(uuid()) @db.VarChar(36)
  tenantId    String      @map("tenant_id") @db.VarChar(36)
  employeeId  String      @map("employee_id") @db.VarChar(36)
  leaveTypeId String?     @map("leave_type_id") @db.VarChar(36)
  approverId  String?     @map("approver_id") @db.VarChar(36)
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  days        Int         @default(1)
  status      LeaveStatus @default(pending)
  reason      String?     @db.Text
  approvedAt  DateTime?   @map("approved_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])   // Perf: pending leave count dashboard
  @@index([tenantId, employeeId]) // Perf: per-employee leave history
  @@map("leave_requests")
}

model PayrollRun {
  id              String        @id @default(uuid()) @db.VarChar(36)
  tenantId        String        @map("tenant_id") @db.VarChar(36)
  periodMonth     Int           @map("period_month")
  periodYear      Int           @map("period_year")
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(15, 2)
  totalNet        Decimal?      @map("total_net") @db.Decimal(15, 2)
  totalDeductions Decimal?      @map("total_deductions") @db.Decimal(15, 2)
  employeeCount   Int           @default(0) @map("employee_count")
  approvalStatus  String        @default("draft") @map("approval_status") @db.VarChar(30) // draft, calculated, under_review, approved, finalized, paid
  approvedBy      String?       @map("approved_by") @db.VarChar(150)
  approvedAt      DateTime?     @map("approved_at")
  status          PayrollStatus @default(draft)
  processedAt     DateTime?     @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips  Payslip[]
  snapshots PayrollSnapshot[]
  bankDisbursementBatches BankDisbursementBatch[]
  statutoryReturnFilings  StatutoryReturnFiling[]

  @@index([tenantId, status])  // Perf: payroll run listing
  @@index([tenantId, periodYear, periodMonth]) // Perf: period-based lookup
  @@map("payroll_runs")
}

model Payslip {
  id           String      @id @default(uuid()) @db.VarChar(36)
  tenantId     String      @map("tenant_id") @db.VarChar(36)
  payrollRunId String?     @map("payroll_run_id") @db.VarChar(36)
  employeeId   String      @map("employee_id") @db.VarChar(36)
  periodMonth  Int         @map("period_month")
  periodYear   Int         @map("period_year")
  grossSalary  Decimal     @map("gross_salary") @db.Decimal(12, 2)
  deductions   Decimal     @default(0.00) @db.Decimal(12, 2)
  netSalary    Decimal     @map("net_salary") @db.Decimal(12, 2)
  breakdown    Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, payrollRunId])
  @@map("payslips")
}

model SalaryComponent {
  id              String   @id @default(uuid()) @db.VarChar(36)
  tenantId        String   @map("tenant_id") @db.VarChar(36)
  name            String   @db.VarChar(100)
  code            String   @db.VarChar(50)
  type            String   @db.VarChar(20) // earning, deduction, reimbursement, statutory_employer
  calculationType String   @map("calculation_type") @db.VarChar(50) // flat, percentage_of_ctc, percentage_of_basic, formula, statutory_esi, fixed_amount
  formulaString   String?  @map("formula_string") @db.VarChar(500)
  defaultValue    Decimal  @default(0.00) @map("default_value") @db.Decimal(12, 2)
  isTaxable       Boolean  @default(true) @map("is_taxable")
  isStatutory     Boolean  @default(false) @map("is_statutory")
  includeInPf     Boolean  @default(false) @map("include_in_pf")
  includeInEsi    Boolean  @default(false) @map("include_in_esi")
  roundOff        String   @default("nearest") @map("round_off") @db.VarChar(20)
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  description     String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structureItems SalaryStructureItem[]
  salaryItems    EmployeeSalaryItem[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("salary_components")
}

model SalaryStructure {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  tenantId            String   @map("tenant_id") @db.VarChar(36)
  name                String   @db.VarChar(150)
  description         String?  @db.Text
  isDefault           Boolean  @default(false) @map("is_default")
  baseCalculationDays Int      @default(26) @map("base_calculation_days")
  payFrequency        String   @default("monthly") @map("pay_frequency") @db.VarChar(30)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       SalaryStructureItem[]
  assignments EmployeeSalaryAssignment[]

  @@index([tenantId, isDefault])
  @@map("salary_structures")
}

model SalaryStructureItem {
  id              String   @id @default(uuid()) @db.VarChar(36)
  structureId     String   @map("structure_id") @db.VarChar(36)
  componentId     String   @map("component_id") @db.VarChar(36)
  calculationType String   @map("calculation_type") @db.VarChar(50)
  value           Decimal  @default(0.00) @db.Decimal(12, 4)
  formula         String?  @db.VarChar(500)
  sortOrder       Int      @default(0) @map("sort_order")

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([structureId, sortOrder])
  @@map("salary_structure_items")
}

model EmployeeSalaryAssignment {
  id            String    @id @default(uuid()) @db.VarChar(36)
  tenantId      String    @map("tenant_id") @db.VarChar(36)
  employeeId    String    @map("employee_id") @db.VarChar(36)
  structureId   String?   @map("structure_id") @db.VarChar(36)
  ctcAnnual     Decimal   @map("ctc_annual") @db.Decimal(15, 2)
  ctcMonthly    Decimal   @map("ctc_monthly") @db.Decimal(15, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isCurrent     Boolean   @default(true) @map("is_current")
  taxRegime     String    @default("new") @map("tax_regime") @db.VarChar(20)
  remarks       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure?     @relation(fields: [structureId], references: [id], onDelete: SetNull)
  items     EmployeeSalaryItem[]

  @@index([tenantId, employeeId, isCurrent])
  @@map("employee_salary_assignments")
}

model EmployeeSalaryItem {
  id            String   @id @default(uuid()) @db.VarChar(36)
  assignmentId  String   @map("assignment_id") @db.VarChar(36)
  componentId   String   @map("component_id") @db.VarChar(36)
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  annualAmount  Decimal  @map("annual_amount") @db.Decimal(15, 2)

  assignment EmployeeSalaryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  component  SalaryComponent          @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("employee_salary_items")
}

model StatutoryRule {
  id              String    @id @default(uuid()) @db.VarChar(36)
  tenantId        String    @map("tenant_id") @db.VarChar(36)
  ruleType        String    @map("rule_type") @db.VarChar(50) // EPF, ESI, PT, GRATUITY, TDS_ITA2025, LWF, BONUS, MINIMUM_WAGE
