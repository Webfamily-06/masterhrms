}

model AssetActivityLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  assetId     String?  @map("asset_id") @db.VarChar(36)
  actionType  String   @map("action_type") @db.VarChar(50) // create, assign, return, transfer, maintenance, disposal, damage, request
