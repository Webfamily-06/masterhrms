  @@index([tenantId, category])
  @@map("training_courses")
}

model CourseModule {
  id              String   @id @default(uuid()) @db.VarChar(36)
  courseId        String   @map("course_id") @db.VarChar(36)
  orderIndex      Int      @default(1) @map("order_index")
  title           String   @db.VarChar(200)
  content         String?  @db.Text
  videoUrl        String?  @map("video_url") @db.VarChar(500)
  durationMinutes Int      @default(30) @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, orderIndex])
  @@map("course_modules")
}

model CourseEnrollment {
  id              String    @id @default(uuid()) @db.VarChar(36)
  tenantId        String    @map("tenant_id") @db.VarChar(36)
  courseId        String    @map("course_id") @db.VarChar(36)
  employeeId      String    @map("employee_id") @db.VarChar(36)
  progressPercent Int       @default(0) @map("progress_percent")
  score           Float?    @default(0)
  status          String    @default("not_started") @db.VarChar(50) // not_started, in_progress, completed
  certificateId   String?   @map("certificate_id") @db.VarChar(50)
  certifiedAt     DateTime? @map("certified_at")
  expiryDate      DateTime? @map("expiry_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, courseId, employeeId])
  @@index([tenantId, status])
  @@map("course_enrollments")
}

// -------------------------------------------------------------
// EMPLOYEE OFFBOARDING & EXIT SETTLEMENT ENGINE
// -------------------------------------------------------------

model EmployeeExit {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  tenantId            String    @map("tenant_id") @db.VarChar(36)
  employeeId          String    @map("employee_id") @db.VarChar(36)
  exitCode            String    @map("exit_code") @db.VarChar(50)
  resignationDate     DateTime  @map("resignation_date") @db.Date
  lastWorkingDay      DateTime  @map("last_working_day") @db.Date
  reason              String    @db.Text
  exitType            String    @default("resignation") @map("exit_type") @db.VarChar(50) // resignation, retirement, termination, contract_end
  status              String    @default("serving_notice") @db.VarChar(50) // serving_notice, clearance_pending, fnf_settled, completed
  noticePeriodDays    Int       @default(60) @map("notice_period_days")
  itClearance         Boolean   @default(false) @map("it_clearance")
  itNotes             String?   @map("it_notes") @db.Text
  itClearedAt         DateTime? @map("it_cleared_at")
  financeClearance    Boolean   @default(false) @map("finance_clearance")
  financeNotes        String?   @map("finance_notes") @db.Text
  financeClearedAt    DateTime? @map("finance_cleared_at")
  hrClearance         Boolean   @default(false) @map("hr_clearance")
  hrNotes             String?   @map("hr_notes") @db.Text
  hrClearedAt         DateTime? @map("hr_cleared_at")
  adminClearance      Boolean   @default(false) @map("admin_clearance")
  adminNotes          String?   @map("admin_notes") @db.Text
  adminClearedAt      DateTime? @map("admin_cleared_at")
  fnfSettlementAmount Decimal?  @default(0.00) @map("fnf_settlement_amount") @db.Decimal(12, 2)
  fnfSettlementStatus String    @default("pending") @map("fnf_settlement_status") @db.VarChar(50) // pending, paid
  fnfSettledAt        DateTime? @map("fnf_settled_at")
  relievingLetterCode String?   @map("relieving_letter_code") @db.VarChar(50)
  exitInterviewNotes  String?   @map("exit_interview_notes") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklists ExitChecklistItem[]

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("employee_exits")
}

model ExitChecklistItem {
  id          String    @id @default(uuid()) @db.VarChar(36)
  exitId      String    @map("exit_id") @db.VarChar(36)
  department  String    @db.VarChar(50) // IT, Finance, HR, Admin
  title       String    @db.VarChar(200)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedBy String?   @map("completed_by") @db.VarChar(100)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

