  @@index([userId])
  @@map("two_factor_otps")
}

model CrmLead {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  title       String   @db.VarChar(200)
  contactName String   @map("contact_name") @db.VarChar(150)
