  totalBeneficiaries      Int       @map("total_beneficiaries")
  totalDisbursementAmount Decimal   @map("total_disbursement_amount") @db.Decimal(15, 2)
  currency                String    @default("INR") @db.VarChar(10)
  formatType              String    @map("format_type") @db.VarChar(30) // pipe_delimited, csv, fixed_width
  fileHash                String?   @map("file_hash") @db.VarChar(64)
  filePath                String?   @map("file_path") @db.VarChar(500)
  isDigitallySigned       Boolean   @default(false) @map("is_digitally_signed")
  signatureDigest         String?   @map("signature_digest") @db.Text
  signatureFileUrl        String?   @map("signature_file_url") @db.VarChar(500)
  signerIdentity          String?   @map("signer_identity") @db.VarChar(150)
  signedAt                DateTime? @map("signed_at")
  status                  String    @default("draft") @db.VarChar(30) // draft, approved, generated, disbursed, reconciled, cancelled
  generatedBy             String?   @map("generated_by") @db.VarChar(150)
  downloadCount           Int       @default(0) @map("download_count")
  reconciledAt            DateTime? @map("reconciled_at")
  reconciledBy            String?   @map("reconciled_by") @db.VarChar(150)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun             @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  items      BankDisbursementItem[]

  @@unique([tenantId, batchReference])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, status])
  @@map("bank_disbursement_batches")
}

model BankDisbursementItem {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  batchId              String   @map("batch_id") @db.VarChar(36)
  employeeId           String   @map("employee_id") @db.VarChar(36)
  beneficiaryName      String   @map("beneficiary_name") @db.VarChar(150)
  accountNumber        String   @map("account_number") @db.VarChar(50)
  ifscCode             String   @map("ifsc_code") @db.VarChar(20)
  amount               Decimal  @db.Decimal(12, 2)
  paymentMode          String   @default("NEFT") @map("payment_mode") @db.VarChar(20)
  transactionReference String?  @map("transaction_reference") @db.VarChar(50)
  status               String   @default("pending") @db.VarChar(30) // pending, success, failed, returned
  failureReason        String?  @map("failure_reason") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")

  batch    BankDisbursementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([employeeId])
  @@map("bank_disbursement_items")
}

model StatutoryReturnFiling {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  tenantId           String    @map("tenant_id") @db.VarChar(36)
  establishmentId    String?   @map("establishment_id") @db.VarChar(36)
  payrollRunId       String    @map("payroll_run_id") @db.VarChar(36)
  returnType         String    @map("return_type") @db.VarChar(30) // EPF_ECR, ESIC_MONTHLY, PT_RETURN
  wageMonth          Int       @map("wage_month")
  wageYear           Int       @map("wage_year")
  totalMembers       Int       @map("total_members")
  totalWages         Decimal   @map("total_wages") @db.Decimal(15, 2)
  totalEmployeeShare Decimal   @map("total_employee_share") @db.Decimal(15, 2)
  totalEmployerShare Decimal   @map("total_employer_share") @db.Decimal(15, 2)
  totalChallanAmount Decimal   @map("total_challan_amount") @db.Decimal(15, 2)
  fileFormat         String    @map("file_format") @db.VarChar(20) // txt, xlsx, csv
  fileHash           String?   @map("file_hash") @db.VarChar(64)
  filePath           String?   @map("file_path") @db.VarChar(500)
  challanTrrn        String?   @map("challan_trrn") @db.VarChar(50)
  status             String    @default("draft") @db.VarChar(30) // draft, generated, uploaded, paid, reconciled
  uploadedAt         DateTime? @map("uploaded_at")
  generatedBy        String?   @map("generated_by") @db.VarChar(150)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  payrollRun    PayrollRun     @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([tenantId, establishmentId, returnType, wageYear, wageMonth])
  @@index([tenantId, returnType, status])
  @@map("statutory_return_filings")
}

model WorkspaceTodo {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  completed   Boolean   @default(false)
  priority    String    @default("medium") @db.VarChar(50)
  tag         String?   @db.VarChar(50)
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("workspace_todos")
}

model WorkspaceNote {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  title       String   @db.VarChar(255)
  content     String   @db.Text
  tag         String   @default("personal") @db.VarChar(50)
  priority    String   @default("medium") @db.VarChar(50)
  isPinned    Boolean  @default(false) @map("is_pinned")
  isStarred   Boolean  @default(false) @map("is_starred")
  isTrash     Boolean  @default(false) @map("is_trash")
  color       String   @default("default") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("workspace_notes")
}

model CalendarEvent {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @map("tenant_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  allDay      Boolean   @default(false) @map("all_day")
  category    String    @default("general") @db.VarChar(50)
  location    String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([startDate, endDate])
  @@map("calendar_events")
}

model SubscriptionNotificationEvent {
  id             String    @id @default(uuid()) @db.VarChar(36)
  tenantId       String    @map("tenant_id") @db.VarChar(36)
  subscriptionId String    @map("subscription_id") @db.VarChar(36)
  cycleKey       String    @map("cycle_key") @db.VarChar(50)
  eventType      String    @map("event_type") @db.VarChar(50)
  recipientEmail String    @map("recipient_email") @db.VarChar(255)
  status         String    @default("sent") @db.VarChar(30)
  attemptCount   Int       @default(1) @map("attempt_count")
  lastAttemptAt  DateTime  @default(now()) @map("last_attempt_at")
  sentAt         DateTime? @map("sent_at")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, cycleKey, eventType])
  @@index([tenantId])
  @@index([subscriptionId])
  @@map("subscription_notification_events")
}



