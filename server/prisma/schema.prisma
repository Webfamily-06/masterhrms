// ==========================================
// ASSET MANAGEMENT ADD-ON
// ==========================================
model AssetCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @default("💻") @db.VarChar(50)
  prefix      String   @default("AST") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@unique([tenantId, slug])
  @@map("asset_categories")
}

model Asset {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  tenantId           String    @map("tenant_id") @db.VarChar(36)
  assetTag           String    @map("asset_tag") @db.VarChar(100)
  name               String    @db.VarChar(255)
  category           String    @default("laptop") @db.VarChar(100)
  categoryId         String?   @map("category_id") @db.VarChar(36)
  brand              String?   @db.VarChar(100)
  model              String?   @db.VarChar(100)
  serialNumber       String?   @map("serial_number") @db.VarChar(150)
  isBatch            Boolean   @default(false) @map("is_batch")
  totalQuantity      Int       @default(1) @map("total_quantity")
  availableQuantity  Int       @default(1) @map("available_quantity")
  unit               String    @default("pcs") @db.VarChar(50)
  location           String?   @db.VarChar(150)
  images             Json?
  qrCode             String?   @map("qr_code") @db.VarChar(255)
  purchaseDate       DateTime? @map("purchase_date") @db.Date
  purchasePrice      Decimal?  @map("purchase_price") @db.Decimal(12, 2)
  vendor             String?   @db.VarChar(150)
  warrantyExpiry     DateTime? @map("warranty_expiry") @db.Date
  condition          String    @default("good") @db.VarChar(50) // new, good, fair, damaged
  status             String    @default("available") @db.VarChar(50) // available, assigned, maintenance, retired, lost, disposed
  assignedEmployeeId String?   @map("assigned_employee_id") @db.VarChar(36)
  assignedAt         DateTime? @map("assigned_at")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRel      AssetCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedEmployee Employee?           @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignments      AssetAssignment[]
  maintenanceLogs  AssetMaintenance[]
  disposalItems    AssetDisposalItem[]
  activityLogs     AssetActivityLog[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("assets")
}

model AssetAssignment {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  assetId            String    @map("asset_id") @db.VarChar(36)
  employeeId         String?   @map("employee_id") @db.VarChar(36)
  departmentId       String?   @map("department_id") @db.VarChar(36)
  locationName       String?   @map("location_name") @db.VarChar(150)
  targetType         String    @default("employee") @map("target_type") @db.VarChar(50) // employee, department, location
  quantity           Int       @default(1)
  assignedAt         DateTime  @default(now()) @map("assigned_at")
  expectedReturnDate DateTime? @map("expected_return_date") @db.Date
  returnedAt         DateTime? @map("returned_at")
  conditionOnAssign  String    @default("good") @map("condition_on_assign") @db.VarChar(50)
  conditionOnReturn  String?   @map("condition_on_return") @db.VarChar(50)
  status             String    @default("active") @db.VarChar(50) // active, returned, damaged, lost, repair
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("asset_assignments")
}

model AssetRequest {
  id           String    @id @default(uuid()) @db.VarChar(36)
  tenantId     String    @map("tenant_id") @db.VarChar(36)
  employeeId   String    @map("employee_id") @db.VarChar(36)
