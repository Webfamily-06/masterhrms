  brandId           String?   @map("brand_id") @db.VarChar(36)
  unitId            String?   @map("unit_id") @db.VarChar(36)
  taxRateId         String?   @map("tax_rate_id") @db.VarChar(36)
  salePrice         Decimal   @default(0.00) @map("sale_price") @db.Decimal(15, 2)
  purchasePrice     Decimal   @default(0.00) @map("purchase_price") @db.Decimal(15, 2)
