{
  "name": "tanstack_start_ts",
  "private": true,
  "workspaces": [
    "server",
    "CMS"
  ],
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run cms:dev\" \"npm run server:dev\"",
    "dev:cms": "npm --prefix CMS run dev",
    "dev:all": "concurrently \"npm run cms:dev\" \"npm run server:dev\"",
    "dev:vite": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js dev",
    "dev:frontend": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js dev",
    "server:dev": "npm --prefix server run dev",
    "server:push": "npm --prefix server run prisma:push",
    "server:studio": "npm --prefix server run prisma:studio",
    "cms:dev": "npm --prefix CMS run dev",
    "cms:build": "npm --prefix CMS run build",
    "cms:typecheck": "npm --prefix CMS run typecheck",
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:vite": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "postinstall": "npm --prefix server run prisma:generate",
    "preview": "vite preview",
    "preview:cms": "npm --prefix CMS run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:cms-isolation": "npx --prefix server vitest run src/tests/cms-tenant-host-isolation.test.ts",
    "test:architecture": "node scripts/test_architecture_consolidation.mjs",
    "test:redirects": "./server/node_modules/.bin/tsx scripts/test_production_redirect_resolution.mjs",
    "test:todo-consolidation": "node scripts/test_todo_tasks_consolidation.cjs",
    "test:workspace-routing": "./server/node_modules/.bin/tsx scripts/test_workspace_routing_architecture.cjs",
    "test:todo-calendar": "./server/node_modules/.bin/tsx scripts/test_todo_calendar_integration.cjs",
    "test:todo-functional-fixes": "./server/node_modules/.bin/tsx scripts/test_todo_gantt_functional_fixes.cjs",
    "test:todo-notifications": "./server/node_modules/.bin/tsx scripts/test_todo_notifications_and_email_templates.cjs",
    "test:domain-resolution": "node scripts/test_domain_environment_resolution.mjs",
    "format": "prettier --write .",
    "doctor": "npx react-doctor@latest"
  },
